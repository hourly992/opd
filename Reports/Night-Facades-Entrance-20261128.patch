diff --git a/Unity_Walk/Assets/Editor/StreetNightSurfaceRepair.cs b/Unity_Walk/Assets/Editor/StreetNightSurfaceRepair.cs
new file mode 100644
index 0000000..0a8a756
--- /dev/null
+++ b/Unity_Walk/Assets/Editor/StreetNightSurfaceRepair.cs
@@ -0,0 +1,351 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using UnityEditor;
+using UnityEngine;
+using UnityEngine.Rendering;
+using UnityEngine.Rendering.HighDefinition;
+using UnityEngine.SceneManagement;
+using Object = UnityEngine.Object;
+using Random = System.Random;
+
+public static class StreetNightSurfaceRepair
+{
+    private const string RootName = "Двор №7 и гаражи · стык и осенние детали";
+    private const string AssetRoot = "Assets/StreetHDRP/EntranceSurfaceRepair";
+    private const float TileHeight = .16f;
+    private const float CoverDepth = .224f;
+    private const float SeamOverlap = .003f;
+    private static readonly Vector2 WestEnd = new(61.15059f, 38.24216f);
+    private static readonly Vector2 NorthCorner = new(61.15272f, 39.505f);
+    private static readonly Vector2 NorthEnd = new(62.199f, 39.505f);
+    private static readonly Color[] Leaves =
+    {
+        new(.73f, .35f, .024f), new(.77f, .49f, .055f), new(.51f, .19f, .018f),
+        new(.61f, .28f, .037f), new(.43f, .16f, .033f)
+    };
+
+    public static void Apply(Scene scene)
+    {
+        if (!scene.isLoaded || scene.path != "Assets/Scenes/Street.unity")
+            throw new ArgumentException("Open the saved Street scene before repairing the entrance.");
+
+        var roots = scene.GetRootGameObjects();
+        var previous = roots.SingleOrDefault(root => root.name == RootName);
+        if (previous)
+            Undo.DestroyObjectImmediate(previous);
+
+        var colliders = roots.Where(root => root && root.activeInHierarchy)
+            .SelectMany(root => root.GetComponentsInChildren<MeshCollider>())
+            .Where(collider => collider.enabled && collider.sharedMesh).ToArray();
+        MeshCollider threshold = Surface("Surfaces/Court7LowThreshold");
+        MeshCollider localAsphalt = Surface("SouthGarageCourt/Retained_18_LocalAsphalt");
+        MeshCollider mergedAsphalt = Surface("SeparatedGarageCanopies/GarageEdge01_Retained_20_House13ApronRetainedAsphalt");
+        var asphaltSources = new[] { localAsphalt, mergedAsphalt };
+        var asphaltMaterial = localAsphalt.GetComponent<MeshRenderer>().sharedMaterial;
+        if (!asphaltMaterial || asphaltMaterial.shader.name != "Street/Asphalt020S")
+            throw new InvalidOperationException("The entrance asphalt material has changed.");
+
+        Directory.CreateDirectory(AssetRoot + "/Meshes");
+        AssetDatabase.Refresh();
+        var root = new GameObject(RootName);
+        SceneManager.MoveGameObjectToScene(root, scene);
+        Undo.RegisterCreatedObjectUndo(root, "Repair the local courtyard surface");
+        Physics.SyncTransforms();
+        var seam = BuildSeam(root.transform, threshold, asphaltSources, asphaltMaterial);
+        Physics.SyncTransforms();
+        AddEntranceDirt(root.transform, threshold);
+        AddLeaves(root.transform, scene, threshold, seam, asphaltSources,
+            new[] { Surface("SeparatedGarageCanopies/CentralAsphalt"), Surface("SeparatedGarageCanopies/GarageApproaches") });
+
+        MeshCollider Surface(string asset)
+        {
+            var mesh = AssetDatabase.LoadAssetAtPath<Mesh>($"Assets/Art/StreetRepair/{asset}.asset");
+            if (!mesh)
+                throw new InvalidOperationException($"The saved entrance surface is missing: {asset}.");
+            return colliders.Single(c => c.sharedMesh == mesh);
+        }
+    }
+
+    private static MeshCollider BuildSeam(Transform root, MeshCollider threshold,
+        MeshCollider[] asphalt, Material material)
+    {
+        var mesh = new EnvironmentMesh();
+        var tests = new List<(Vector2 tile, Vector2 join, float height)>();
+        // The saved cutout exposes the raised edge of the original landing. Bring the asphalt
+        // up to that contour, following the actual approach where the new asphalt tapers out.
+        Strip(WestEnd, NorthCorner, new Vector2(-.43f, 0), new Vector2(-.46f, 0), 14, false, CoverDepth);
+        Strip(NorthCorner, NorthEnd, new Vector2(0, .33f), new Vector2(0, .22f), 12, true, 0);
+        for (int step = 0; step < 5; step++)
+        {
+            float first = step / 5f;
+            float second = (step + 1) / 5f;
+            for (int band = 0; band < 8; band++)
+            {
+                float inner = band / 8f;
+                float outer = (band + 1) / 8f;
+                mesh.Face(material, Vector3.up, Corner(first, inner), Corner(second, inner),
+                    Corner(second, outer), Corner(first, outer));
+            }
+        }
+
+        var node = mesh.Create("Court7AsphaltThresholdJoin", "Асфальт до кромки красной плитки", AssetRoot);
+        node.transform.SetParent(root, false);
+        node.layer = asphalt[0].gameObject.layer;
+        GameObjectUtility.SetStaticEditorFlags(node, StaticEditorFlags.BatchingStatic);
+        var collider = node.AddComponent<MeshCollider>();
+        collider.sharedMesh = node.GetComponent<MeshFilter>().sharedMesh;
+        Physics.SyncTransforms();
+        float largestStep = 0;
+        foreach (var probe in tests)
+        {
+            if (!Read(threshold, probe.tile, out var tile) || !Read(collider, probe.join, out var join) ||
+                Mathf.Abs(tile.point.y - probe.height) > .003f || join.normal.y < .88f)
+                throw new InvalidOperationException($"The repaired entrance lacks continuous support at {probe.join:F3}.");
+            largestStep = Mathf.Max(largestStep, Mathf.Abs(tile.point.y - join.point.y));
+        }
+        if (largestStep > .014f)
+            throw new InvalidOperationException($"Entrance seam has a {largestStep:F3}m jump.");
+        foreach (float z in new[] { 38.53f, 38.78f, 39.04f, 39.29f, 39.46f })
+        {
+            if (!Read(collider, new Vector2(60.929f, z), out var cover) || cover.point.y < TileHeight - .004f)
+                throw new InvalidOperationException($"The narrow inner lip still lacks asphalt cover at z={z:F3}.");
+        }
+        Debug.Log($"COURT7_ENTRANCE_JOIN probes={tests.Count} coveredLip=5 maximumStep={largestStep:F4}m asphalt={material.name}");
+        return collider;
+
+        void Strip(Vector2 start, Vector2 end, Vector2 firstOffset, Vector2 lastOffset, int rows, bool taper, float flatDepth)
+        {
+            const int bands = 8;
+            var row = new Vector3[rows + 1, bands + 1];
+            for (int station = 0; station <= rows; station++)
+            {
+                float t = station / (float)rows;
+                Vector2 edge = Vector2.Lerp(start, end, t);
+                Vector2 offset = Vector2.Lerp(firstOffset, lastOffset, t);
+                Vector2 inside = edge - offset.normalized * SeamOverlap;
+                float edgeLift = taper ? 1f - .75f * Mathf.SmoothStep(0, 1, Mathf.InverseLerp(.9f, 1, t)) : 1;
+                for (int band = 0; band <= bands; band++)
+                {
+                    float fraction = band / (float)bands;
+                    row[station, band] = SurfaceVertex(Vector2.Lerp(inside, edge + offset, fraction),
+                        edgeLift * Falloff(fraction, offset.magnitude, flatDepth));
+                }
+                if (station > 0 && station < rows && edgeLift > .99f)
+                {
+                    Vector2 tileProbe = edge - offset.normalized * .015f;
+                    if (!Read(threshold, tileProbe, out var landing) || Mathf.Abs(landing.point.y - TileHeight) > .002f)
+                        throw new InvalidOperationException($"The edge of the saved red landing moved at {tileProbe:F3}.");
+                    tests.Add((tileProbe, edge + offset.normalized * .018f, landing.point.y));
+                }
+            }
+            for (int station = 0; station < rows; station++)
+            for (int band = 0; band < bands; band++)
+                mesh.Face(material, Vector3.up, row[station, band], row[station + 1, band],
+                    row[station + 1, band + 1], row[station, band + 1]);
+        }
+
+        Vector3 SurfaceVertex(Vector2 point, float weight)
+        {
+            if (!ReadHighest(asphalt, point, out var contact))
+                throw new InvalidOperationException($"The entrance asphalt no longer underlies the join at {point:F3}.");
+            float baseHeight = Mathf.Min(TileHeight - .002f, contact.point.y + .0015f);
+            return new Vector3(point.x, Mathf.Lerp(baseHeight, TileHeight - .0015f, weight), point.y);
+        }
+
+        Vector3 Corner(float turn, float distance)
+        {
+            float angle = Mathf.Lerp(Mathf.PI, Mathf.PI * .5f, turn);
+            var radial = new Vector2(Mathf.Cos(angle) * .46f, Mathf.Sin(angle) * .33f);
+            return SurfaceVertex(NorthCorner + radial * distance,
+                Falloff(distance, radial.magnitude, Mathf.Lerp(CoverDepth, 0, turn)));
+        }
+
+        float Falloff(float fraction, float width, float flatDepth) =>
+            Mathf.Pow(1 - Mathf.InverseLerp(flatDepth / width, 1, fraction), 1.38f);
+    }
+
+    private static void AddEntranceDirt(Transform parent, MeshCollider threshold)
+    {
+        var dust = AssetDatabase.LoadAssetAtPath<Material>("Assets/StreetHDRP/LivedInSurfaces/Dry soil film.mat");
+        if (!dust)
+            throw new InvalidOperationException("The existing dry soil decal is missing.");
+        foreach (var center in new[] { new Vector2(61.33f, 39.30f), new Vector2(61.62f, 37.28f) })
+        {
+            if (!Read(threshold, center, out var hit))
+                throw new InvalidOperationException($"No saved step below the dirt mark at {center:F3}.");
+            var point = new GameObject("Сухая грязь в углу ступени").transform;
+            point.SetParent(parent, false);
+            point.SetPositionAndRotation(hit.point, Quaternion.LookRotation(-hit.normal, Vector3.forward));
+            var decal = point.gameObject.AddComponent<DecalProjector>();
+            decal.material = dust;
+            decal.pivot = Vector3.zero;
+            decal.size = new Vector3(.29f, .22f, .032f);
+            decal.drawDistance = 18f;
+            decal.fadeScale = .7f;
+            decal.fadeFactor = .77f;
+            decal.startAngleFade = 25f;
+            decal.endAngleFade = 65f;
+        }
+    }
+
+    private static void AddLeaves(Transform root, Scene scene, MeshCollider threshold, MeshCollider seam,
+        MeshCollider[] asphalt, MeshCollider[] canopySurfaces)
+    {
+        var leaf = AssetDatabase.LoadAssetAtPath<Material>("Assets/PhotoReconstruction/Stage08Autumn/Materials/FallenLeaves.mat");
+        if (!leaf || !leaf.HasProperty("_LeafAtlas") || !leaf.GetTexture("_LeafAtlas"))
+            throw new InvalidOperationException("The existing district leaf atlas is required.");
+
+        var entrance = new LeafBatch(new Vector3(61, 0, 38));
+        var ramps = new LeafBatch(new Vector3(26, 0, -43));
+        var underTrees = new LeafBatch(new Vector3(47, 0, 42));
+        var hardscape = asphalt.Append(seam).ToArray();
+        var step = new[] { threshold };
+        var random = new Random(287011);
+        Scatter(entrance, new(61.07f, 39.08f), new(.095f, .38f), 29, hardscape, true);
+        Scatter(entrance, new(60.96f, 38.73f), new(.13f, .21f), 13, hardscape, true);
+        Scatter(entrance, new(61.25f, 39.64f), new(.42f, .13f), 29, hardscape, true);
+        Scatter(entrance, new(60.11f, 41.15f), new(.68f, .20f), 34, hardscape, true);
+        Scatter(entrance, new(61.05f, 40.98f), new(.40f, .16f), 23, hardscape, true);
+        Scatter(entrance, new(61.41f, 39.32f), new(.17f, .12f), 6, step, false);
+        Scatter(entrance, new(61.51f, 37.24f), new(.23f, .12f), 7, step, false);
+        Scatter(ramps, new(24.02f, -44.2f), new(.36f, .90f), 36, canopySurfaces, true);
+        Scatter(ramps, new(25.58f, -42.9f), new(.51f, .32f), 22, canopySurfaces, true);
+        Scatter(ramps, new(28.63f, -41.64f), new(.42f, .62f), 27, canopySurfaces, true);
+        Scatter(ramps, new(27.08f, -45.32f), new(.44f, .29f), 12, canopySurfaces, false);
+
+        var trees = Object.FindObjectsByType<LODGroup>()
+            .Where(group => group.gameObject.scene == scene && TreeInCourtyard(group))
+            .OrderBy(group => group.transform.position.x).ThenBy(group => group.transform.position.z).Take(5);
+        foreach (var tree in trees)
+        {
+            Vector3 position = tree.transform.position;
+            Scatter(underTrees, new(position.x + .55f, position.z - .34f), new(1.5f, .95f), 16, null, false);
+        }
+
+        if (entrance.Count < 65 || ramps.Count < 28)
+            throw new InvalidOperationException($"Insufficient supported leaves at the checked sites: {entrance.Count}/{ramps.Count}.");
+        entrance.Save(root, "EntranceLeaves", "Листья у бордюра, стыка и ступени", leaf);
+        ramps.Save(root, "CanopyLeaves", "Листья у двух гаражных навесов", leaf);
+        underTrees.Save(root, "CourtyardTreeLeaves", "Листья под деревьями во дворе", leaf);
+        Debug.Log($"ENTRANCE_SURFACE_LEAVES entrance={entrance.Count} canopies={ramps.Count} treeGround={underTrees.Count}");
+
+        void Scatter(LeafBatch batch, Vector2 center, Vector2 radius, int attempts, MeshCollider[] allowed, bool pile)
+        {
+            for (int index = 0; index < attempts; index++)
+            {
+                float angle = Unit(random) * 2 * Mathf.PI;
+                float distance = Mathf.Pow(Unit(random), pile ? 1.15f : .65f);
+                Vector2 point = center + Vector2.Scale(radius, new Vector2(Mathf.Cos(angle), Mathf.Sin(angle))) * distance;
+                var ray = Down(point);
+                if (!scene.GetPhysicsScene().Raycast(ray.origin, ray.direction, out var floor, 2.65f,
+                        Physics.DefaultRaycastLayers, QueryTriggerInteraction.Ignore) ||
+                    floor.normal.y < .82f || floor.collider is not MeshCollider collider ||
+                    (allowed != null && !allowed.Contains(collider)) ||
+                    (allowed == null && !IsQuietTreeGround(collider)))
+                    continue;
+
+                float size = Mathf.Lerp(.066f, .139f, Unit(random));
+                Vector3 along = Quaternion.AngleAxis(Unit(random) * 360f, floor.normal) *
+                    Vector3.ProjectOnPlane(Vector3.forward, floor.normal).normalized * size;
+                Vector3 across = Vector3.Cross(floor.normal, along) * Mathf.Lerp(.67f, 1.03f, Unit(random));
+                float height = pile ? Mathf.Lerp(.008f, .031f, Mathf.Pow(Unit(random), 2.4f)) : .008f;
+                batch.Add(floor.point + floor.normal * height, along, across, floor.normal,
+                    Leaves[random.Next(Leaves.Length)] * Mathf.Lerp(.72f, 1.09f, Unit(random)), random.Next(3));
+            }
+        }
+    }
+
+    private static bool TreeInCourtyard(LODGroup group)
+    {
+        var p = group.transform.position;
+        if (p.x < 24 || p.x > 116 || p.z < 31 || p.z > 57)
+            return false;
+        var lod = group.GetLODs();
+        return lod.Length > 0 && lod[0].renderers.Any(renderer => renderer && renderer.bounds.size.y > 2.3f &&
+            renderer.sharedMaterials.Any(material => material && material.HasProperty("_AutumnAmount") &&
+                material.HasProperty("_Grass") && material.GetFloat("_Grass") < .25f &&
+                material.GetFloat("_AutumnAmount") > .25f));
+    }
+
+    private static bool IsQuietTreeGround(MeshCollider collider)
+    {
+        if (!collider.sharedMesh)
+            return false;
+        string name = collider.sharedMesh.name;
+        return collider.name == "Grass" || name.StartsWith("Lawn_", StringComparison.Ordinal) ||
+            name.StartsWith("IslandRelief05_", StringComparison.Ordinal) || name == "Stage04CourtPaving";
+    }
+
+    private static bool ReadHighest(MeshCollider[] colliders, Vector2 point, out RaycastHit best)
+    {
+        best = default;
+        bool found = false;
+        foreach (var collider in colliders)
+        {
+            if (!Read(collider, point, out var hit) || (found && hit.point.y <= best.point.y))
+                continue;
+            best = hit;
+            found = true;
+        }
+        return found;
+    }
+
+    private static Ray Down(Vector2 point) => new(new Vector3(point.x, 1.6f, point.y), Vector3.down);
+
+    private static bool Read(MeshCollider collider, Vector2 point, out RaycastHit hit) =>
+        collider.Raycast(Down(point), out hit, 2.65f) && hit.normal.y >= .78f;
+
+    private static float Unit(Random random) => (float)random.NextDouble();
+
+    private sealed class LeafBatch
+    {
+        private readonly Vector3 origin;
+        private readonly List<Vector3> vertices = new();
+        private readonly List<Vector2> uv = new();
+        private readonly List<Color32> colors = new();
+        private readonly List<int> triangles = new();
+        public int Count { get; private set; }
+
+        public LeafBatch(Vector3 origin) => this.origin = origin;
+
+        public void Add(Vector3 position, Vector3 along, Vector3 across, Vector3 normal, Color tint, int variant)
+        {
+            tint.a = 1;
+            AutumnLeafShape.Append(vertices, uv, colors, triangles, position - origin,
+                along, across, normal, tint, variant, true);
+            Count++;
+        }
+
+        public void Save(Transform root, string assetName, string objectName, Material material)
+        {
+            if (Count == 0)
+                return;
+            string path = $"{AssetRoot}/Meshes/{assetName}.asset";
+            var mesh = AssetDatabase.LoadAssetAtPath<Mesh>(path);
+            if (!mesh)
+            {
+                mesh = new Mesh { name = assetName };
+                AssetDatabase.CreateAsset(mesh, path);
+            }
+            mesh.Clear();
+            mesh.SetVertices(vertices);
+            mesh.SetUVs(0, uv);
+            mesh.SetColors(colors);
+            mesh.SetTriangles(triangles, 0);
+            mesh.RecalculateNormals();
+            mesh.tangents = EnvironmentMesh.Tangents(mesh.normals);
+            EditorUtility.SetDirty(mesh);
+
+            var node = new GameObject(objectName).transform;
+            node.SetParent(root, false);
+            node.localPosition = origin;
+            node.gameObject.AddComponent<MeshFilter>().sharedMesh = mesh;
+            var renderer = node.gameObject.AddComponent<MeshRenderer>();
+            renderer.sharedMaterial = material;
+            renderer.shadowCastingMode = ShadowCastingMode.Off;
+            renderer.reflectionProbeUsage = ReflectionProbeUsage.Off;
+        }
+    }
+}
