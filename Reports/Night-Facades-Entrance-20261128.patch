+    private void SelectFacadeSpots()
+    {
+        int assigned = 0;
+        for (int slot = 0; slot < nearest.Length && assigned < FacadeBudget; slot++)
+        {
+            int index = nearest[slot];
+            if (index < 0) break;
+            var lamp = lamps[index];
+            bool samePole = false;
+            for (int previous = 0; previous < assigned; previous++)
+                samePole |= lamps[facadeAssignments[previous]].transform.parent == lamp.transform.parent;
+            if (samePole) continue;
+            if (!facadeSearched[index])
+            {
+                facadeSearched[index] = true;
+                facadeAim[index] = FindFacade(lamp);
+            }
+            if (facadeAim[index] == Vector3.zero) continue;
+            facadeAssignments[assigned++] = index;
+        }
+        for (int slot = assigned; slot < FacadeBudget; slot++)
+            facadeAssignments[slot] = -1;
+    }
+
+    private static Vector3 FindFacade(Light lamp)
+    {
+        // The main spot stays aimed at the footway or road. The second beam
+        // follows the nearest unobstructed residential wall from the same lens.
+        Vector3 origin = lamp.transform.position + Vector3.down * .24f;
+        Vector3 aim = Vector3.zero;
+        float nearestDistance = lamp.range > 15f ? 15f : 10f;
+        for (int sample = 0; sample < 16; sample++)
+        {
+            Vector3 horizontal = Quaternion.AngleAxis(sample * 22.5f, Vector3.up) * Vector3.forward;
+            Vector3 direction = (horizontal + Vector3.down * .24f).normalized;
+            if (!Physics.Raycast(origin + direction * .4f, direction, out var hit, nearestDistance,
+                    Physics.DefaultRaycastLayers, QueryTriggerInteraction.Ignore) || hit.distance < 1.5f ||
+                Mathf.Abs(hit.normal.y) > .3f || Vector3.Dot(hit.normal, -direction) < .45f ||
+                !IsBuildingWall(hit.transform))
+                continue;
+            nearestDistance = hit.distance;
+            aim = hit.point - origin;
+        }
+        return aim;
+    }
+
+    private static bool IsBuildingWall(Transform surface)
+    {
+        for (var parent = surface; parent; parent = parent.parent)
+            if (parent.TryGetComponent<StreetBuilding>(out _) ||
+                parent.name.StartsWith("Дом №5", System.StringComparison.Ordinal))
+                return true;
+        return false;
+    }
+
+    private void UpdateFacadeSpots(float deepNight)
+    {
+        for (int slot = 0; slot < FacadeBudget; slot++)
+        {
+            int index = facadeAssignments[slot];
+            Light spot = facadeSpots[slot];
+            float weight = index >= 0 ? currentWeight[index] * deepNight : 0f;
+            if (weight <= .003f)
+            {
+                if (spot && spot.enabled) spot.enabled = false;
+                continue;
+            }
+            if (!spot) spot = facadeSpots[slot] = CreateFacadeSpot();
+            var lamp = lamps[index];
+            Vector3 aim = facadeAim[index];
+            spot.transform.SetPositionAndRotation(lamp.transform.position + Vector3.down * .24f,
+                Quaternion.LookRotation(aim, Vector3.up));
+            spot.colorTemperature = lamp.colorTemperature;
+            spot.range = aim.magnitude + 3.5f;
+            spot.intensity = Mathf.Clamp(aim.sqrMagnitude * 62f, 320f, 5500f) * weight;
+            if (!spot.enabled) spot.enabled = true;
+        }
+    }
+
+    private Light CreateFacadeSpot()
+    {
+        var source = new GameObject("Тёплый свет фонаря на фасаде") { hideFlags = HideFlags.DontSave };
+        source.transform.SetParent(transform, false);
+        var light = source.AddComponent<Light>();
+        light.enabled = false;
+        light.type = LightType.Spot;
+        light.lightUnit = LightUnit.Candela;
+        light.useColorTemperature = true;
+        light.spotAngle = 39f;
+        light.innerSpotAngle = 16f;
+        light.shadows = LightShadows.None;
+        var data = source.AddComponent<HDAdditionalLightData>();
+        data.affectDiffuse = true;
+        data.affectSpecular = true;
+        data.affectsVolumetric = false;
+        return light;
+    }
