@@ -0,0 +1,90 @@
+using System;
+using System.IO;
+using System.Linq;
+using UnityEditor;
+using UnityEngine;
+using UnityEngine.SceneManagement;
+
+public static class StreetCourtyardAutumnGrass
+{
+    private const string AssetRoot = "Assets/StreetHDRP/EntranceSurfaceRepair/Grass";
+    private const string VarietyRoot = "Assets/StreetHDRP/CourtVarietyGrass";
+
+    public static void Apply(Scene scene)
+    {
+        if (!scene.isLoaded || scene.path != "Assets/Scenes/Street.unity")
+            throw new ArgumentException("Open the saved Street scene before adjusting the courtyard grass.");
+
+        var turfMesh = AssetDatabase.LoadAssetAtPath<Mesh>("Assets/Art/StreetRepair/LawnGrades/Lawn_1_0.asset");
+        var renderers = scene.GetRootGameObjects()
+            .SelectMany(root => root.GetComponentsInChildren<MeshRenderer>()).ToArray();
+        var playgroundLawn = renderers.Single(renderer =>
+            turfMesh && renderer.TryGetComponent<MeshFilter>(out var filter) && filter.sharedMesh == turfMesh);
+
+        Directory.CreateDirectory(AssetRoot);
+        AssetDatabase.Refresh();
+        var lawnSource = Load("Assets/Art/AutumnGrass/Lawn ground.mat");
+        var islandSource = Load(VarietyRoot + "/Court No7 Living turf and worn soil.mat");
+        var bladesSource = Load(VarietyRoot + "/Court No7 Mixed blades and weeds.mat");
+        var lawn = Variant(lawnSource, "Playground lawn autumn", new Color(.74f, .77f, .45f), .49f);
+        lawn.SetFloat("_MeadowDrying", .46f);
+        var island = Variant(islandSource, "Court 7 island autumn", new Color(.67f, .79f, .44f), .57f);
+        var blades = Variant(bladesSource, "Court 7 dry blades", new Color(.99f, .86f, .76f));
+        if (!Rebind(playgroundLawn, lawnSource, lawn))
+            throw new InvalidOperationException("The playground lawn is no longer using its expected source material.");
+
+        int islands = renderers.Count(renderer => Rebind(renderer, islandSource, island));
+        int bladeBatches = renderers.Count(renderer => Rebind(renderer, bladesSource, blades));
+        if (islands != 3 || bladeBatches < 3)
+            throw new InvalidOperationException($"Unrecognized courtyard grass binding: {islands} islands, {bladeBatches} grass batches.");
+        Debug.Log($"COURTYARD_AUTUMN_GRASS playground={playgroundLawn.name} islands={islands} blades={bladeBatches}");
+    }
+
+    private static Material Load(string path)
+    {
+        var source = AssetDatabase.LoadAssetAtPath<Material>(path);
+        if (!source)
+            throw new InvalidOperationException($"Could not load lawn material: {path}");
+        return source;
+    }
+
+    private static Material Variant(Material source, string name, Color tint, float saturation = -1)
+    {
+        string path = $"{AssetRoot}/{name}.mat";
+        var result = AssetDatabase.LoadAssetAtPath<Material>(path);
+        if (!result)
+        {
+            result = new Material(source) { name = name };
+            AssetDatabase.CreateAsset(result, path);
+        }
+        result.CopyPropertiesFromMaterial(source);
+        result.SetColor("_Color", tint);
+        if (saturation >= 0)
+            result.SetFloat("_Saturation", saturation);
+        EditorUtility.SetDirty(result);
+        return result;
+    }
+
+    private static bool Rebind(MeshRenderer renderer, Material source, Material variant)
+    {
+        var materials = renderer.sharedMaterials;
+        bool sourceFound = false, replaced = false;
+        for (int index = 0; index < materials.Length; index++)
+        {
+            if (materials[index] == variant)
+                sourceFound = true;
+            if (materials[index] != source)
+                continue;
+            materials[index] = variant;
+            sourceFound = true;
+            replaced = true;
+        }
+        if (replaced)
+        {
+            Undo.RecordObject(renderer, "Adjust local courtyard grass palette");
+            renderer.sharedMaterials = materials;
+            EditorUtility.SetDirty(renderer);
+        }
+        return sourceFound;
+    }
+}
