+using System;
+using System.IO;
+using System.Linq;
+using UnityEditor;
+using UnityEditor.SceneManagement;
+using UnityEngine;
+using UnityEngine.Rendering;
+using UnityEngine.Rendering.HighDefinition;
+using UnityEngine.SceneManagement;
+
+public static class StreetNightFinish
+{
+    private const string ScenePath = "Assets/Scenes/Street.unity";
+    private const string LightsName = "Подъезд №7 · свет под навесом";
+
+    public static void Apply()
+    {
+        var scene = EditorSceneManager.OpenScene(ScenePath, OpenSceneMode.Single);
+        ApplyEntranceLights(scene);
+        StreetNightSurfaceRepair.Apply(scene);
+        StreetCourtyardAutumnGrass.Apply(scene);
+        EditorSceneManager.MarkSceneDirty(scene);
+        if (!EditorSceneManager.SaveScene(scene)) throw new IOException("Could not save the Street scene.");
+        AssetDatabase.SaveAssets();
+    }
+
+    public static void ApplyAndBuild()
+    {
+        Apply();
+        AutumnMenuInstall.Build();
+    }
+
+    private static void ApplyEntranceLights(Scene scene)
+    {
+        var cycle = scene.GetRootGameObjects().SelectMany(root => root.GetComponentsInChildren<StreetDayNight>(true)).Single();
+        var building = scene.GetRootGameObjects().SelectMany(root => root.GetComponentsInChildren<StreetBuilding>(true))
+            .Single(candidate => candidate.address == "7" && candidate.GetComponentsInChildren<Transform>(true)
+                .Any(point => point.name == "Access · подход к крыльцу 1" &&
+                    Vector3.Distance(point.position, new Vector3(61.091938f, 0f, 38.305f)) < .03f));
+        var entry = building.GetComponentsInChildren<Transform>(true).Single(point => point.name == "Access · подход к крыльцу 1");
+        if (Vector3.Dot(entry.forward, Vector3.left) < .999f)
+            throw new InvalidOperationException("Unexpected central entrance direction.");
+
+        var group = scene.GetRootGameObjects().SingleOrDefault(root => root.name == LightsName);
+        if (group) UnityEngine.Object.DestroyImmediate(group);
+        group = new GameObject(LightsName);
+        // The source is below the existing canopy, with overlapping beams on the
+        // door and the paving. Use the inspected approach as the reference frame.
+        var lights = new[]
+        {
+            AddSpot(group.transform, "Дверь и откосы", At(.18f, 2.51f, -.87f),
+                At(0f, .82f, -1.43f), 390f, 81f, 3.6f, 2900f),
+            AddSpot(group.transform, "Площадка и ступень", At(.13f, 2.51f, -.83f),
+                At(-.12f, .14f, .06f), 260f, 68f, 4.1f, 3000f)
+        };
+        cycle.BindEntranceLights(lights);
+        EditorUtility.SetDirty(cycle);
+        Debug.Log($"STREET_NIGHT_ENTRANCE address={building.address} position={lights[0].transform.position} fixtures={lights.Length}");
+
+        Vector3 At(float side, float height, float outward) =>
+            entry.position + entry.right * side + Vector3.up * height + entry.forward * outward;
+    }
+
+    private static Light AddSpot(Transform parent, string name, Vector3 origin, Vector3 target,
+        float candela, float angle, float range, float kelvin)
+    {
+        var source = new GameObject(name);
+        source.transform.SetParent(parent, false);
+        source.transform.SetPositionAndRotation(origin, Quaternion.LookRotation(target - origin));
+        var light = source.AddComponent<Light>();
+        light.enabled = false;
+        light.type = LightType.Spot;
+        light.lightmapBakeType = LightmapBakeType.Realtime;
+        light.lightUnit = LightUnit.Candela;
+        light.intensity = candela;
+        light.range = range;
+        light.spotAngle = angle;
+        light.innerSpotAngle = angle * .53f;
+        light.color = Color.white;
+        light.useColorTemperature = true;
+        light.colorTemperature = kelvin;
+        var data = source.GetComponent<HDAdditionalLightData>() ?? source.AddComponent<HDAdditionalLightData>();
+        data.interactsWithSky = false;
+        data.affectDiffuse = true;
+        data.affectSpecular = true;
+        data.affectsVolumetric = false;
+        return light;
+    }
+}
