+using System;
+using System.IO;
+using System.Linq;
+using UnityEditor;
+using UnityEditor.SceneManagement;
+using UnityEngine;
+using UnityEngine.Rendering.HighDefinition;
+using UnityEngine.SceneManagement;
+
+public static class StreetRoadPilotInstall
+{
+    private const string ScenePath = "Assets/Scenes/Street.unity";
+    private const string RoadMeshPath = "Assets/Art/StreetRepair/Surfaces/ReferenceRoad.asset";
+    private const string RoadMaterialGuid = "121909ce7feba9c4799a6aa47553085b";
+    private const string PilotFolder = "Assets/StreetHDRP/RoadPilot";
+    private const string RootName = "Пробное покрытие · северная прямая";
+    private static readonly Vector3 Start = new(-114.0897f, 0f, 149f);
+    private static readonly Vector3 End = new(-98.9692f, 0f, 121f);
+    private const float Width = 7f;
+
+    [MenuItem("Street/Road/Apply northern asphalt pilot")]
+    public static void Apply()
+    {
+        var scene = EditorSceneManager.OpenScene(ScenePath, OpenSceneMode.Single);
+        var mesh = AssetDatabase.LoadAssetAtPath<Mesh>(RoadMeshPath);
+        var original = AssetDatabase.LoadAssetAtPath<Material>(AssetDatabase.GUIDToAssetPath(RoadMaterialGuid));
+        if (!mesh || !original || original.shader.name != "Street/Asphalt020S")
+            throw new InvalidOperationException("The saved Asphalt020S carriageway is required.");
+
+        var road = UnityEngine.Object.FindObjectsByType<MeshCollider>().Single(collider =>
+            collider.gameObject.scene == scene && collider.sharedMesh == mesh &&
+            collider.TryGetComponent<MeshRenderer>(out var renderer) && renderer.sharedMaterial == original);
+        var existing = scene.GetRootGameObjects().SingleOrDefault(item => item.name == RootName);
+        if (existing)
+        {
+            Verify(existing, scene, original);
+            return;
+        }
+
+        var shader = AssetDatabase.LoadAssetAtPath<Shader>(PilotFolder + "/AsphaltPilotBlend.shadergraph");
+        if (!shader || ShaderUtil.ShaderHasError(shader))
+            throw new InvalidOperationException("The HDRP asphalt blending graph must import without errors.");
+
+        Vector3 along = (End - Start).normalized;
+        float length = Vector3.Distance(Start, End);
+        var root = new GameObject(RootName);
+        SceneManager.MoveGameObjectToScene(root, scene);
+        try
+        {
+            int detailCount = StreetRoadPilotDecals.Apply(root.transform, road, 0, Start, End);
+            AddBlend(root.transform, road, original, shader, along, length);
+            Verify(root, scene, original);
+            AssetDatabase.SaveAssets();
+            EditorSceneManager.MarkSceneDirty(scene);
+            if (!EditorSceneManager.SaveScene(scene))
+                throw new IOException("Could not save the northern road pilot.");
+            Debug.Log(FormattableString.Invariant($"ROAD_PILOT_SAVED length={length:F2} width={Width:F2} detailDecals={detailCount}"));
+        }
+        catch
+        {
+            UnityEngine.Object.DestroyImmediate(root);
+            throw;
+        }
+    }
+
+    public static void ApplyAndBuild()
+    {
+        Apply();
+        AutumnMenuInstall.Build();
+    }
+
+    private static void AddBlend(Transform root, MeshCollider road, Material original, Shader shader,
+        Vector3 along, float length)
+    {
+        Vector3 across = Vector3.Cross(Vector3.up, along);
+        float low = float.PositiveInfinity, high = float.NegativeInfinity;
+        for (int index = 0; index <= 8; index++)
+        foreach (float offset in new[] { -3.43f, 0f, 3.43f })
+        {
+            Vector3 p = Vector3.Lerp(Start, End, index / 8f) + across * offset;
+            if (!road.Raycast(new Ray(p + Vector3.up * 2f, Vector3.down), out var hit, 4f) ||
+                hit.triangleIndex >= road.sharedMesh.GetIndexCount(0) / 3 || hit.normal.y < .95f)
+                throw new InvalidOperationException("The blending projector would leave the reference carriageway.");
+            low = Mathf.Min(low, hit.point.y);
+            high = Mathf.Max(high, hit.point.y);
+        }
+        if (high - low > .07f)
+            throw new InvalidOperationException("The pilot asphalt elevation exceeds its shallow projector depth.");
+
+        string path = PilotFolder + "/Asphalt020S pilot blend.mat";
+        var material = AssetDatabase.LoadAssetAtPath<Material>(path);
+        if (!material)
+        {
+            material = new Material(shader);
+            AssetDatabase.CreateAsset(material, path);
+        }
+        if (material.shader != shader)
+            throw new InvalidOperationException("The pilot blend material has an unexpected shader.");
+
+        material.SetTexture("_AsphaltColorMap", original.GetTexture("_MainTex"));
+        material.SetTexture("_AsphaltAORoughnessMap", original.GetTexture("_MaskMap"));
+        material.SetVector("_AsphaltTileMeters", original.GetVector("_TileMeters"));
+        material.SetVector("_AsphaltToneGain", Vector4.Scale(original.GetVector("_ToneGain"), original.GetColor("_Color")));
+        material.SetVector("_PilotAxis", new Vector4(Start.x, Start.z, along.x, along.z));
+        material.SetVector("_PilotDimensions", new Vector4(length, Width, 4f, .12f));
+        material.SetFloat("_FinishStrength", 1);
+        HDMaterial.ValidateMaterial(material);
+        EditorUtility.SetDirty(material);
+
+        var node = new GameObject("Asphalt020S · плавное смешивание");
+        node.transform.SetParent(root, false);
+        Vector3 center = (Start + End) * .5f;
+        center.y = (low + high) * .5f;
+        node.transform.SetPositionAndRotation(center, Quaternion.LookRotation(Vector3.down, along));
+        var projector = node.AddComponent<DecalProjector>();
+        projector.material = material;
+        projector.pivot = Vector3.zero;
+        projector.size = new Vector3(Width, length, high - low + .012f);
+        projector.drawDistance = 90f;
+        projector.fadeScale = .75f;
+        projector.startAngleFade = 24f;
+        projector.endAngleFade = 58f;
+    }
+
+    private static void Verify(GameObject root, Scene scene, Material original)
+    {
+        var decals = root.GetComponentsInChildren<DecalProjector>();
+        var blend = decals.SingleOrDefault(decal => decal.material &&
+            AssetDatabase.GetAssetPath(decal.material.shader) == PilotFolder + "/AsphaltPilotBlend.shadergraph");
+        if (!blend || !blend.material.HasProperty("_PilotAxis") ||
+            blend.material.GetTexture("_AsphaltColorMap") != original.GetTexture("_MainTex") ||
+            blend.material.GetTexture("_AsphaltAORoughnessMap") != original.GetTexture("_MaskMap") ||
+            ShaderUtil.ShaderHasError(blend.material.shader) || decals.Length < 8 || decals.Length > 9 ||
+            root.gameObject.scene != scene || root.GetComponentsInChildren<Collider>().Length != 0)
+            throw new InvalidOperationException("The saved road pilot is incomplete or affects collision.");
+        Debug.Log($"ROAD_PILOT_VERIFIED shader={blend.material.shader.name} projectors={decals.Length} geometry=unchanged");
+    }
+}
