@@ -0,0 +1,62 @@
+#ifndef STREET_ASPHALT_PILOT_BLEND_INCLUDED
+#define STREET_ASPHALT_PILOT_BLEND_INCLUDED
+
+float AsphaltPilotHash(float2 p)
+{
+    float3 q = frac(float3(p.x, p.y, p.x) * float3(.1031, .1030, .0973));
+    q += dot(q, q.yzx + 33.33);
+    return frac((q.x + q.y) * q.z);
+}
+
+float AsphaltPilotNoise(float2 p)
+{
+    float2 cell = floor(p);
+    float2 t = frac(p);
+    t = t * t * (3.0 - 2.0 * t);
+    return lerp(lerp(AsphaltPilotHash(cell), AsphaltPilotHash(cell + float2(1, 0)), t.x),
+                lerp(AsphaltPilotHash(cell + float2(0, 1)), AsphaltPilotHash(cell + 1.0), t.x), t.y);
+}
+
+void AsphaltPilotBlend_float(float3 WorldPosition, UnityTexture2D AsphaltColor, UnityTexture2D AsphaltMask,
+    float2 TileMeters, float4 ToneGain, float4 Axis, float4 Dimensions, float Strength,
+    out float3 BaseColor, out float Smoothness, out float Opacity)
+{
+    float2 p = WorldPosition.xz - Axis.xy;
+    float2 forward = Axis.zw;
+    float station = dot(p, forward);
+    float offset = dot(p, float2(forward.y, -forward.x));
+    float edgeDistance = 0.5 * Dimensions.y - abs(offset);
+
+    // Mask out both ends and the centerline paint. The projector is confined to the carriageway.
+    float ends = smoothstep(0.0, Dimensions.z, min(station, Dimensions.x - station));
+    float sides = smoothstep(0.015, Dimensions.w, edgeDistance);
+    float paint = smoothstep(.15, .38, abs(offset));
+    Opacity = ends * sides * paint * saturate(Strength);
+
+    // Three unrelated spatial scales avoid repeating the asphalt tile at road scale.
+    float2 samplePoint = float2(offset, station);
+    float broad = AsphaltPilotNoise(samplePoint * float2(.19, .096) + float2(12, 29));
+    float medium = AsphaltPilotNoise(samplePoint * float2(.47, .23) + float2(8, 42));
+    float variation = .70 * (broad - .5) + .30 * (medium - .5);
+
+    // Wheel paths are diffuse, vary in width and fade independently in the two lanes.
+    float laneSeed = offset < 0 ? 41.5 : 73.8;
+    float wander = (AsphaltPilotNoise(float2(station * .16, laneSeed)) - .5) * .29;
+    float wheelDistance = min(abs(abs(offset) - .92 + wander), abs(abs(offset) - 2.45 + wander));
+    float wear = (1.0 - smoothstep(.13, .62, wheelDistance))
+        * lerp(.32, 1.0, AsphaltPilotNoise(float2(station * .19, laneSeed + 14.2)));
+
+    float edgeVariation = AsphaltPilotNoise(float2(station * .33, laneSeed + 6.2));
+    float dust = (1.0 - smoothstep(.05, lerp(.21, .71, edgeVariation), edgeDistance))
+        * smoothstep(.17, .78, edgeVariation);
+
+    // Asphalt020S repeats in world metres; the original normal and occlusion remain in the road material.
+    float2 uv = float2(WorldPosition.x, -WorldPosition.z) / max(TileMeters, .05);
+    float3 asphalt = SAMPLE_TEXTURE2D(AsphaltColor.tex, AsphaltColor.samplerstate, uv).rgb * ToneGain.rgb;
+    float roughness = SAMPLE_TEXTURE2D(AsphaltMask.tex, AsphaltMask.samplerstate, uv).g;
+    BaseColor = asphalt * (1.0 + .31 * variation - .085 * wear);
+    BaseColor = lerp(BaseColor, asphalt * float3(1.24, 1.14, 1.01), dust * .48);
+    Smoothness = 1.0 - saturate(roughness + .14 * variation - .041 * wear + .087 * dust);
+}
+
+#endif
