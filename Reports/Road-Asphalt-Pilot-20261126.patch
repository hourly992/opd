index 0000000..49c826c
--- /dev/null
+++ b/Assets/Editor/StreetRoadPilotDecals.cs
@@ -0,0 +1,269 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using UnityEditor;
+using UnityEngine;
+using UnityEngine.Rendering.HighDefinition;
+using UnityEngine.SceneManagement;
+
+internal static class StreetRoadPilotDecals
+{
+    private const string RootName = "Пробное покрытие · декали дороги";
+    private const string MaterialFolder = "Assets/StreetHDRP/RoadPilotDecals";
+    private static readonly float[] StationAdjustments = { 0f, .8f, -.8f, 1.6f, -1.6f, 2.5f, -2.5f, 3.4f, -3.4f };
+    private static readonly float[] InteriorAdjustments = { 0f, .32f, -.32f, .62f, -.62f };
+    private static readonly float[] AcrossSamples = { -1f, -.5f, 0f, .5f, 1f };
+
+    [Serializable]
+    private sealed class RoadObstacles
+    {
+        public StreetBuilder.Point[] crossings;
+        public StreetBuilder.Point[] manholes;
+    }
+
+    private readonly struct Detail
+    {
+        public readonly string Name, Material;
+        public readonly float Fraction, Lateral, Yaw, Width, Length, Opacity;
+        public readonly bool IsCurb;
+
+        public Detail(string name, string material, float fraction, float lateral, float yaw,
+            float width, float length, float opacity, bool isCurb = false)
+        {
+            Name = name;
+            Material = material;
+            Fraction = fraction;
+            Lateral = lateral;
+            Yaw = yaw;
+            Width = width;
+            Length = length;
+            Opacity = opacity;
+            IsCurb = isCurb;
+        }
+    }
+
+    private static readonly Detail[] Details =
+    {
+        new("Свежая ремонтная заплата", "Fresh repair", .25f, 1.62f, -9f, 1.55f, 2.50f, .96f),
+        new("Старая ремонтная заплата", "Weathered repair", .67f, -1.57f, 19f, 1.18f, 1.93f, .89f),
+        new("Тонкая трещина", "Hairline crack", .43f, -1.34f, 71f, .47f, 1.56f, .87f),
+        new("Тонкая трещина с ответвлением", "Branched crack", .81f, 1.59f, 22f, .59f, 1.19f, .77f),
+        new("Пыль вдоль бордюра", "Curb dust", .16f, -1f, 0f, .36f, 2.37f, .68f, true),
+        new("Пыль вдоль бордюра", "Curb dust", .39f, 1f, 0f, .32f, 3.22f, .76f, true),
+        new("Небольшой нанос сухого грунта", "Curb soil", .56f, -1f, 0f, .39f, 1.91f, .80f, true),
+        new("Пыль вдоль бордюра", "Curb dust", .83f, 1f, 0f, .40f, 2.10f, .62f, true),
+    };
+
+    private readonly struct Placement
+    {
+        public readonly Detail Detail;
+        public readonly Material Material;
+        public readonly Vector3 Ground, Along;
+        public readonly float Depth;
+
+        public Placement(Detail detail, Material material, Vector3 ground, Vector3 along, float depth)
+        {
+            Detail = detail;
+            Material = material;
+            Ground = ground;
+            Along = along;
+            Depth = depth;
+        }
+    }
+
+    internal static int Apply(Transform root, MeshCollider carriageway, int slot, Vector3 start, Vector3 end)
+    {
+        if (!root || !carriageway || root.gameObject.scene != carriageway.gameObject.scene)
+            throw new ArgumentException("The pilot and the carriageway must be in the same loaded scene.");
+        if (!carriageway.sharedMesh || slot < 0 || slot >= carriageway.sharedMesh.subMeshCount)
+            throw new ArgumentException("The saved main asphalt submesh is required.");
+
+        var existingRoot = root.Find(RootName);
+        var ground = new Carriageway(carriageway, slot, start, end, existingRoot);
+        Physics.SyncTransforms();
+
+        var placements = new List<Placement>(Details.Length);
+        foreach (var detail in Details)
+        {
+            var material = AssetDatabase.LoadAssetAtPath<Material>($"{MaterialFolder}/{detail.Material}.mat");
+            if (!material || material.shader.name != "HDRP/Decal")
+                throw new InvalidOperationException($"Native decal material missing: {detail.Material}.");
+            if (ground.TryPlace(detail, material, out var placement))
+                placements.Add(placement);
+            else
+                Debug.LogWarning($"ROAD_PILOT_DECAL_SKIPPED {detail.Material} station={detail.Fraction}");
+        }
+
+        if (placements.Count(item => item.Detail.Material.EndsWith("repair", StringComparison.Ordinal)) != 2 ||
+            !placements.Any(item => item.Detail.Material.EndsWith("crack", StringComparison.Ordinal)) ||
+            placements.Count(item => item.Detail.IsCurb) < 3 ||
+            !placements.Any(item => item.Detail.Material == "Curb soil"))
+            throw new InvalidOperationException("The pilot did not find safe asphalt footprints for its patches, crack and curb deposits.");
+
+        if (existingRoot)
+            UnityEngine.Object.DestroyImmediate(existingRoot.gameObject);
+        var group = new GameObject(RootName).transform;
+        group.SetParent(root, false);
+        foreach (var placement in placements)
+            AddProjector(group, placement);
+
+        return placements.Count;
+    }
+
+    private static void AddProjector(Transform group, Placement placement)
+    {
+        Detail detail = placement.Detail;
+        var node = new GameObject(detail.Name);
+        node.transform.SetParent(group, false);
+        node.transform.SetPositionAndRotation(placement.Ground, Quaternion.LookRotation(Vector3.down, placement.Along));
+        var projector = node.AddComponent<DecalProjector>();
+        projector.material = placement.Material;
+        projector.size = new Vector3(detail.Width, detail.Length, placement.Depth);
+        projector.pivot = Vector3.zero;
+        projector.fadeFactor = detail.Opacity;
+        projector.drawDistance = detail.IsCurb ? 38f : 52f;
+        projector.fadeScale = .72f;
+        projector.startAngleFade = 28f;
+        projector.endAngleFade = 64f;
+        if (detail.IsCurb && detail.Lateral < 0f)
+        {
+            // Positive U describes the outer edge in the atlas.
+            projector.uvScale = new Vector2(-1f, 1f);
+            projector.uvBias = new Vector2(1f, 0f);
+        }
+        Debug.Log(FormattableString.Invariant($"ROAD_PILOT_DECAL {detail.Material} x={placement.Ground.x:F3} z={placement.Ground.z:F3} width={detail.Width:F2} length={detail.Length:F2} depth={placement.Depth:F3}"));
+    }
+
+    private sealed class Carriageway
+    {
+        private readonly MeshCollider collider;
+        private readonly PhysicsScene physics;
+        private readonly Vector3 start, along, across;
+        private readonly float length;
+        private readonly int firstTriangle, lastTriangle;
+        private readonly RoadObstacles obstacles;
+        private readonly List<(Vector3 point, float radius)> decals;
+
+        public Carriageway(MeshCollider collider, int slot, Vector3 start, Vector3 end, Transform existingRoot)
+        {
+            this.collider = collider;
+            this.start = start;
+            along = end - start;
+            along.y = 0f;
+            length = along.magnitude;
+            if (length < 20f || length > 42f)
+                throw new ArgumentOutOfRangeException(nameof(end), "Use one carriageway segment 20-42 metres long.");
+            along /= length;
+            across = Vector3.Cross(Vector3.up, along);
+            physics = collider.gameObject.scene.GetPhysicsScene();
+            Mesh mesh = collider.sharedMesh;
+            for (int i = 0; i < slot; i++)
+                firstTriangle += (int)mesh.GetIndexCount(i) / 3;
+            lastTriangle = firstTriangle + (int)mesh.GetIndexCount(slot) / 3;
+            obstacles = JsonUtility.FromJson<RoadObstacles>(File.ReadAllText("Assets/StreetSource/road_profiles.json"));
+            decals = UnityEngine.Object.FindObjectsByType<DecalProjector>()
+                .Where(projector => projector.gameObject.scene == collider.gameObject.scene &&
+                    projector.transform.forward.y < -.8f && (!existingRoot || !projector.transform.IsChildOf(existingRoot)))
+                .Select(projector => (projector.transform.position, Mathf.Clamp(.3f * projector.size.y, .26f, 1f)))
+                .ToList();
+        }
+
+        public bool TryPlace(Detail detail, Material material, out Placement placement)
+        {
+            Vector3 direction = Quaternion.AngleAxis(detail.Yaw, Vector3.up) * along;
+            Vector3 side = Vector3.Cross(Vector3.up, direction);
+            foreach (float delta in StationAdjustments)
+            {
+                Vector3 station = start + along * (length * detail.Fraction + delta);
+                if (detail.IsCurb)
+                {
+                    int sign = detail.Lateral < 0 ? -1 : 1;
+                    if (!FindCurb(station, direction, sign, detail.Width, detail.Length, out var curbTarget))
+                        continue;
+                    if (Test(detail, material, curbTarget, direction, side, out placement))
+                        return true;
+                    continue;
+                }
+
+                foreach (float offset in InteriorAdjustments)
+                    if (Test(detail, material, station + across * (detail.Lateral + offset), direction, side, out placement))
+                        return true;
+            }
+
+            placement = default;
+            return false;
+        }
+
+        private bool FindCurb(Vector3 station, Vector3 direction, int sign, float width, float span, out Vector3 target)
+        {
+            target = default;
+            var outward = across * sign;
+            float edge = float.PositiveInfinity;
+            foreach (float alongSample in new[] { -1f, 0f, 1f })
+            {
+                var sample = station + direction * (alongSample * span * .5f);
+                float inside = 2.78f, outside = 3.83f;
+                if (!Sample(sample + outward * inside, out _) || Sample(sample + outward * outside, out _))
+                    return false;
+                for (int step = 0; step < 7; step++)
+                {
+                    float middle = (inside + outside) * .5f;
+                    if (Sample(sample + outward * middle, out _)) inside = middle;
+                    else outside = middle;
+                }
+                edge = Mathf.Min(edge, inside);
+            }
+            target = station + outward * (edge - width * .5f - .035f);
+            return true;
+        }
+
+        private bool Test(Detail detail, Material material, Vector3 center, Vector3 direction, Vector3 side,
+            out Placement placement)
+        {
+            placement = default;
+            float radius = .5f * Mathf.Sqrt(detail.Width * detail.Width + detail.Length * detail.Length);
+            if (decals.Any(decal => HorizontalSqrDistance(decal.point, center) < Mathf.Pow(decal.radius + radius * .7f, 2)))
+                return false;
+            if (obstacles.crossings.Any(point => HorizontalSqrDistance(point.V, center) < Mathf.Pow(3.8f + radius, 2)) ||
+                obstacles.manholes.Any(point => HorizontalSqrDistance(point.V, center) < Mathf.Pow(.48f + radius, 2)))
+                return false;
+
+            float low = float.PositiveInfinity, high = float.NegativeInfinity;
+            foreach (float x in AcrossSamples)
+            foreach (float z in AcrossSamples)
+            {
+                Vector3 p = center + side * (detail.Width * x * .5f) + direction * (detail.Length * z * .5f);
+                float chain = Vector3.Dot(p - start, along);
+                // The existing axis markings occupy a narrow central strip. A margin also
+                // keeps dark repair edges away from the strokes at bends and mip distances.
+                if (chain < 1.4f || chain > length - 1.4f || Mathf.Abs(Vector3.Dot(p - start, across)) < .39f ||
+                    !Sample(p, out float elevation))
+                    return false;
+                low = Mathf.Min(low, elevation);
+                high = Mathf.Max(high, elevation);
+            }
+            if (high - low > .044f)
+                return false;
+
+            center.y = (low + high) * .5f;
+            placement = new Placement(detail, material, center, direction, .026f + high - low);
+            decals.Add((center, radius * .72f));
+            return true;
+        }
+
+        private bool Sample(Vector3 point, out float elevation)
+        {
+            elevation = 0f;
+            if (!physics.Raycast(new Vector3(point.x, 12f, point.z), Vector3.down, out var hit,
+                    25f, ~0, QueryTriggerInteraction.Ignore) || hit.collider != collider || hit.normal.y < .94f ||
+                hit.triangleIndex < firstTriangle || hit.triangleIndex >= lastTriangle)
+                return false;
+            elevation = hit.point.y;
+            return true;
+        }
+
+        private static float HorizontalSqrDistance(Vector3 a, Vector3 b) =>
+            (a.x - b.x) * (a.x - b.x) + (a.z - b.z) * (a.z - b.z);
+    }
+}
