@@ -0,0 +1,98 @@
+using System;
+using System.IO;
+using System.Linq;
+using UnityEditor;
+using UnityEditor.SceneManagement;
+using UnityEngine;
+using UnityEngine.SceneManagement;
+
+public static class StreetCourtVariety
+{
+    private const string ScenePath = "Assets/Scenes/Street.unity";
+    private const string RootName = "Двор №7 · трава и покрытие";
+
+    [MenuItem("Street/Environment/Finish court 7 surfaces and grass")]
+    public static void Apply()
+    {
+        var scene = EditorSceneManager.GetActiveScene();
+        if (Enumerable.Range(0, SceneManager.sceneCount).Any(index => SceneManager.GetSceneAt(index).isDirty))
+            throw new InvalidOperationException("Save open scenes before changing the courtyard visuals.");
+        if (scene.path != ScenePath)
+            scene = EditorSceneManager.OpenScene(ScenePath, OpenSceneMode.Single);
+
+        var roots = scene.GetRootGameObjects();
+        var previous = roots.SingleOrDefault(root => root.name == RootName);
+        var sourceRoots = roots.Where(root => root != previous).ToArray();
+        var originalTransforms = sourceRoots.SelectMany(root => root.GetComponentsInChildren<Transform>(true))
+            .Select(item => (item, parent: item.parent, position: item.localPosition, scale: item.localScale,
+                rotation: item.localRotation)).ToArray();
+        var originalColliders = sourceRoots.SelectMany(root => root.GetComponentsInChildren<Collider>(true))
+            .ToDictionary(item => item, EditorJsonUtility.ToJson);
+        var originalMeshes = sourceRoots.SelectMany(root => root.GetComponentsInChildren<MeshFilter>(true))
+            .Select(item => (item, mesh: item.sharedMesh)).ToArray();
+        var originalMarkings = sourceRoots.SelectMany(root => root.GetComponentsInChildren<MeshRenderer>(true))
+            .Where(item => IsMarking(item.name) || item.sharedMaterials.Any(material => material && IsMarking(material.name)))
+            .ToDictionary(item => item, EditorJsonUtility.ToJson);
+        var originalLights = sourceRoots.SelectMany(root => root.GetComponentsInChildren<Light>(true))
+            .ToDictionary(item => item, EditorJsonUtility.ToJson);
+
+        Undo.IncrementCurrentGroup();
+        int group = Undo.GetCurrentGroup();
+        Undo.SetCurrentGroupName("Finish court 7 surfaces and grass");
+        try
+        {
+            if (previous)
+                Undo.DestroyObjectImmediate(previous);
+
+            var result = new GameObject(RootName);
+            SceneManager.MoveGameObjectToScene(result, scene);
+            Undo.RegisterCreatedObjectUndo(result, "Create courtyard visuals");
+            Physics.SyncTransforms();
+
+            string grass = StreetCourtVarietyGrass.Apply(scene, Section(result.transform, "Газонные островки"));
+            string asphalt = StreetCourtVarietyAsphalt.Apply(scene, Section(result.transform, "Южный дворовый проезд"));
+
+            if (originalTransforms.Any(value => !value.item || value.item.parent != value.parent ||
+                    !value.item.localPosition.Equals(value.position) || !value.item.localScale.Equals(value.scale) ||
+                    !value.item.localRotation.Equals(value.rotation)) ||
+                originalColliders.Any(value => !value.Key || EditorJsonUtility.ToJson(value.Key) != value.Value) ||
+                originalMeshes.Any(value => !value.item || value.item.sharedMesh != value.mesh) ||
+                originalMarkings.Any(value => !value.Key || EditorJsonUtility.ToJson(value.Key) != value.Value) ||
+                originalLights.Any(value => !value.Key || EditorJsonUtility.ToJson(value.Key) != value.Value) ||
+                result.GetComponentInChildren<Collider>(true) || result.GetComponentInChildren<Light>(true))
+                throw new InvalidOperationException("Courtyard visuals changed saved geometry, collision, road markings or lights.");
+
+            AssetDatabase.SaveAssets();
+            EditorSceneManager.MarkSceneDirty(scene);
+            if (!EditorSceneManager.SaveScene(scene))
+                throw new IOException("Could not save courtyard visuals.");
+            Undo.CollapseUndoOperations(group);
+            Debug.Log($"COURT_VARIETY_VERIFIED transforms={originalTransforms.Length} colliders={originalColliders.Count} " +
+                $"meshes={originalMeshes.Length} markings={originalMarkings.Count} lights={originalLights.Count} | " +
+                $"{grass} | {asphalt}");
+        }
+        catch
+        {
+            Undo.RevertAllDownToGroup(group);
+            throw;
+        }
+    }
+
+    public static void ApplyAndBuild()
+    {
+        Apply();
+        AutumnMenuInstall.Build();
+    }
+
+    private static Transform Section(Transform parent, string name)
+    {
+        var section = new GameObject(name).transform;
+        section.SetParent(parent, false);
+        return section;
+    }
+
+    private static bool IsMarking(string text) =>
+        text.Contains("размет", StringComparison.OrdinalIgnoreCase) ||
+        text.Contains("marking", StringComparison.OrdinalIgnoreCase) ||
+        text.Contains("road paint", StringComparison.OrdinalIgnoreCase);
+}
