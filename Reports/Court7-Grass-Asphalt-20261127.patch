diff --git a/Assets/Editor/StreetCourtVarietyAsphalt.cs b/Assets/Editor/StreetCourtVarietyAsphalt.cs
new file mode 100644
index 0000000000000000000000000000000000000000..1d23b1fe40edb3e9adb6e14352ce6e9475a6519f
--- /dev/null
+++ b/Assets/Editor/StreetCourtVarietyAsphalt.cs
@@ -0,0 +1,359 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using UnityEditor;
+using UnityEngine;
+using UnityEngine.Rendering.HighDefinition;
+using UnityEngine.SceneManagement;
+
+public static class StreetCourtVarietyAsphalt
+{
+    private const string AssetFolder = "Assets/StreetHDRP/CourtAsphalt";
+    private const string CurrentScene = "Assets/Scenes/Street.unity";
+    private const string MainAsphalt = "121909ce7feba9c4799a6aa47553085b";
+    private static readonly float[] CandidateYaws = { 0f, -12f, 12f, -24f, 24f, -38f, 38f, -53f, 53f, 90f };
+    private static readonly float[] CandidateOffsets = { 0f, -.55f, .55f, -1.1f, 1.1f, -2f, 2f };
+    private static readonly Vector2[] BandSizes =
+    {
+        new(4.5f, 14f), new(4f, 12f), new(3.6f, 11f), new(3.2f, 9f),
+        new(2.8f, 8f), new(2.4f, 7f), new(2f, 6f)
+    };
+
+    private sealed class Site
+    {
+        public readonly string Name;
+        public readonly string StorageName;
+        public readonly Vector2 Center;
+        public readonly Vector2 Direction;
+        public readonly bool Fresh;
+
+        public Site(string name, string storageName, Vector2 center, Vector2 direction, bool fresh)
+        {
+            Name = name;
+            StorageName = storageName;
+            Center = center;
+            Direction = direction.normalized;
+            Fresh = fresh;
+        }
+    }
+
+    private static readonly Site[] Sites =
+    {
+        new("Проезд у южного газона", "Court 7 · southwest access", new Vector2(39.79f, 10.04f), new Vector2(1, .17f), true),
+        new("Южный дворовой проезд", "Court 7 · southeast access", new Vector2(75.58f, -20.04f), new Vector2(.96f, -.2f), false)
+    };
+
+    public static string Apply(Scene scene, Transform parent)
+    {
+        if (!scene.isLoaded || scene.path != CurrentScene || !parent || parent.gameObject.scene != scene)
+            throw new ArgumentException("The saved Street scene and its pilot parent are required.");
+
+        Physics.SyncTransforms();
+        var ground = new AsphaltGround(scene.GetPhysicsScene());
+        var results = new List<string>();
+        foreach (var site in Sites)
+        {
+            if (!TryFindBand(ground, site, out var band))
+                throw new InvalidOperationException("No continuous local asphalt receiver near " + site.Name);
+            int details = AddSite(parent, ground, site, band);
+            var source = band.Surface;
+            string receiver = $"{site.Name}: receiver={source.Renderer.name}, mesh={source.Collider.sharedMesh.name}, " +
+                $"submesh={source.Slot}, source={source.Material.name}, shader={source.Material.shader.name}";
+            string footprint = FormattableString.Invariant(
+                $"center=({band.Center.x:F2},{band.Center.z:F2}), heading=({band.Along.x:F2},{band.Along.y:F2}), size=({band.Size.x:F2},{band.Size.y:F2})");
+            results.Add($"{receiver}, {footprint}, detail projectors={details}");
+        }
+
+        string summary = string.Join(" | ", results);
+        Debug.Log("COURT_VARIETY_ASPHALT " + summary);
+        return $"Asphalt on {Sites.Length} local access surfaces. {summary}";
+    }
+
+    private static bool TryFindBand(AsphaltGround ground, Site site, out Footprint band)
+    {
+        foreach (var size in BandSizes)
+        foreach (float yaw in CandidateYaws)
+        {
+            Vector2 along = Rotate(site.Direction, yaw);
+            Vector2 across = Across(along);
+            foreach (float lateral in CandidateOffsets)
+            foreach (float shift in new[] { 0f, -1.8f, 1.8f })
+            {
+                Vector2 center = site.Center + across * lateral + along * shift;
+                if (ground.TryFootprint(center, along, size, null, out band))
+                    return true;
+            }
+        }
+        band = default;
+        return false;
+    }
+
+    private static int AddSite(Transform parent, AsphaltGround ground, Site site, Footprint band)
+    {
+        var group = new GameObject(site.Name).transform;
+        group.SetParent(parent, false);
+        var finish = PrepareBaseMaterial(site, band);
+        var renderer = band.Surface.Renderer;
+        var slots = renderer.sharedMaterials;
+        Undo.RecordObject(renderer, "Apply local asphalt finish");
+        slots[band.Surface.Slot] = finish;
+        renderer.sharedMaterials = slots;
+
+        string patchMaterial = site.Fresh ? "Fresh repair" : "Weathered repair";
+        var details = new List<Footprint>();
+        AddTrace(group, ground, band, details, "Ремонтная заплата", patchMaterial,
+            band.Size.y * .10f, -.05f, -13f, new Vector2(1.45f, 2.70f), .99f, 43f);
+        AddTrace(group, ground, band, details, "Трещина с ответвлением", site.Fresh ? "Branched crack" : "Hairline crack",
+            -band.Size.y * .27f, band.Size.x * .12f, 63f, new Vector2(.58f, 1.68f), .98f, 32f);
+        AddTrace(group, ground, band, details, "Сухой грунт у кромки", "Curb soil",
+            -band.Size.y * .27f, band.Size.x * .40f, 0f, new Vector2(.51f, 2.50f), .94f, 34f, edge: true);
+        AddTrace(group, ground, band, details, "Пыль на краю проезда", "Curb dust",
+            band.Size.y * .22f, -band.Size.x * .40f, 0f, new Vector2(.48f, 2.20f), .85f, 34f, edge: true);
+        if (details.Count < 3)
+            throw new InvalidOperationException("Too few verified repair and wear footprints near " + site.Name);
+        return details.Count;
+    }
+
+    private static Material PrepareBaseMaterial(Site site, Footprint band)
+    {
+        string sourceGuid = site.Fresh ? "7b942ee289686b347b7c775fee348368" : "a37b844d7f21b7e46bdfe53dbc813325";
+        var source = AssetDatabase.LoadAssetAtPath<Material>(AssetDatabase.GUIDToAssetPath(sourceGuid));
+        string path = $"{AssetFolder}/{site.StorageName}.mat";
+        var material = AssetDatabase.LoadAssetAtPath<Material>(path);
+        if (!source || source.shader.name != "Street/Asphalt020S" || ShaderUtil.ShaderHasError(source.shader) ||
+            !source.GetTexture("_MainTex") || !source.GetTexture("_MaskMap") || !source.GetTexture("_BumpMap") ||
+            (band.Surface.Material != source && band.Surface.Material != material))
+            throw new InvalidOperationException("Expected the known HDRP asphalt and its original PBR maps.");
+
+        if (!material)
+        {
+            material = new Material(source) { name = site.StorageName };
+            AssetDatabase.CreateAsset(material, path);
+        }
+        material.shader = source.shader;
+        material.CopyPropertiesFromMaterial(source);
+        Vector2 start = ToXZ(band.Center) - band.Along * (band.Size.y * .5f);
+        material.SetVector("_CourtAsphaltAxis", new Vector4(start.x, start.y, band.Along.x, band.Along.y));
+        material.SetVector("_CourtAsphaltDimensions", new Vector4(band.Size.y, band.Size.x, 1.55f, .68f));
+        HDMaterial.ValidateMaterial(material);
+        EditorUtility.SetDirty(material);
+        Debug.Log($"COURT_ASPHALT_MATERIAL {path} | original={source.name} | albedo={AssetDatabase.GetAssetPath(source.GetTexture("_MainTex"))} | " +
+                  $"roughness={AssetDatabase.GetAssetPath(source.GetTexture("_MaskMap"))}");
+        return material;
+    }
+
+    private static Material MaskedTraceMaterial(Material source)
+    {
+        string path = $"{AssetFolder}/Court 7 {source.name} decal.mat";
+        var material = AssetDatabase.LoadAssetAtPath<Material>(path);
+        if (!material)
+        {
+            material = new Material(source) { name = "Court 7 " + source.name + " decal" };
+            AssetDatabase.CreateAsset(material, path);
+        }
+        material.CopyPropertiesFromMaterial(source);
+        // Native presets used constant mask opacity where no mask map was assigned.
+        // Smoothness must follow the irregular color texture's alpha, including at the projector edge.
+        material.SetFloat("_MaskBlendSrc", 0);
+        HDMaterial.ValidateMaterial(material);
+        EditorUtility.SetDirty(material);
+        return material;
+    }
+
+    private static void AddTrace(Transform group, AsphaltGround ground, Footprint band, List<Footprint> occupied,
+        string name, string materialName, float station, float lateral, float yaw, Vector2 size,
+        float opacity, float distance, bool edge = false)
+    {
+        var material = AssetDatabase.LoadAssetAtPath<Material>($"Assets/StreetHDRP/RoadPilotDecals/{materialName}.mat");
+        if (!material || !material.shader || material.shader.name != "HDRP/Decal")
+            throw new InvalidOperationException($"Missing HDRP detail preset '{materialName}'.");
+
+        Vector2 along = Rotate(band.Along, yaw);
+        Vector2 across = Across(band.Along);
+        foreach (float step in new[] { 0f, -.58f, .58f, -1.16f, 1.16f })
+        foreach (float inset in new[] { 0f, -.30f, .30f, -.63f, .63f })
+        {
+            Vector2 center = ToXZ(band.Center) + band.Along * (station + step) + across * (lateral + inset);
+            if (edge)
+                center += across * Mathf.Sign(lateral) * EdgeOffset(ground, center, across * Mathf.Sign(lateral), band.Surface, size.x);
+            if (occupied.Any(footprint => Vector2.Distance(ToXZ(footprint.Center), center) < 1.15f))
+                continue;
+            if (!ground.TryFootprint(center, along, size, band.Surface, out var placement))
+                continue;
+
+            var projector = MakeProjector(group, name, placement, MaskedTraceMaterial(material), opacity, distance);
+            if (edge && lateral < 0)
+            {
+                projector.uvScale = new Vector2(-1f, 1f);
+                projector.uvBias = new Vector2(1f, 0f);
+            }
+            occupied.Add(placement);
+            Debug.Log(FormattableString.Invariant(
+                $"COURT_ASPHALT_DECAL {name} / {materialName} ({placement.Center.x:F2},{placement.Center.z:F2})"));
+            return;
+        }
+        Debug.LogWarning($"COURT_ASPHALT_DECAL_SKIPPED {group.name}: {name} had no isolated supported footprint");
+    }
+
+    private static float EdgeOffset(AsphaltGround ground, Vector2 center, Vector2 outward, GroundHit surface, float width)
+    {
+        for (int step = 1; step <= 9; step++)
+        {
+            float offset = step * .17f;
+            if (!ground.TryRead(center + outward * offset, out var hit) || !hit.SameSurface(surface))
+                return Mathf.Max(0, offset - width * .5f - .19f);
+        }
+
+        return .25f;
+    }
+
+    private static DecalProjector MakeProjector(Transform group, string name, Footprint footprint,
+        Material material, float opacity, float drawDistance)
+    {
+        var node = new GameObject(name).transform;
+        node.SetParent(group, false);
+        node.SetPositionAndRotation(footprint.Center,
+            Quaternion.LookRotation(Vector3.down, new Vector3(footprint.Along.x, 0, footprint.Along.y)));
+        var projector = node.gameObject.AddComponent<DecalProjector>();
+        projector.material = material;
+        projector.pivot = Vector3.zero;
+        projector.size = new Vector3(footprint.Size.x, footprint.Size.y, footprint.Depth);
+        projector.drawDistance = drawDistance;
+        projector.fadeScale = .72f;
+        projector.fadeFactor = opacity;
+        projector.startAngleFade = 28f;
+        projector.endAngleFade = 63f;
+        return projector;
+    }
+
+    private static Vector2 Across(Vector2 along) => new Vector2(along.y, -along.x);
+    private static Vector2 ToXZ(Vector3 world) => new Vector2(world.x, world.z);
+    private static Vector2 Rotate(Vector2 direction, float degrees)
+    {
+        var rotated = Quaternion.AngleAxis(degrees, Vector3.up) * new Vector3(direction.x, 0, direction.y);
+        return ToXZ(rotated);
+    }
+
+    private readonly struct GroundHit
+    {
+        public readonly MeshCollider Collider;
+        public readonly MeshRenderer Renderer;
+        public readonly Material Material;
+        public readonly int Slot;
+        public readonly float Height;
+
+        public GroundHit(MeshCollider collider, MeshRenderer renderer, Material material, int slot, float height)
+        {
+            Collider = collider;
+            Renderer = renderer;
+            Material = material;
+            Slot = slot;
+            Height = height;
+        }
+
+        public bool SameSurface(GroundHit other) => Collider == other.Collider && Slot == other.Slot;
+    }
+
+    private readonly struct Footprint
+    {
+        public readonly GroundHit Surface;
+        public readonly Vector3 Center;
+        public readonly Vector2 Along;
+        public readonly Vector2 Size;
+        public readonly float Depth;
+
+        public Footprint(GroundHit surface, Vector3 center, Vector2 along, Vector2 size, float depth)
+        {
+            Surface = surface;
+            Center = center;
+            Along = along;
+            Size = size;
+            Depth = depth;
+        }
+    }
+
+    private sealed class AsphaltGround
+    {
+        private readonly PhysicsScene scene;
+        private readonly Material main = AssetDatabase.LoadAssetAtPath<Material>(AssetDatabase.GUIDToAssetPath(MainAsphalt));
+        private readonly Dictionary<MeshCollider, (MeshRenderer renderer, Material[] materials, int[] end)> receivers = new();
+
+        public AsphaltGround(PhysicsScene scene)
+        {
+            this.scene = scene;
+            if (!main)
+                throw new InvalidOperationException("The main road guard material is missing from the project.");
+        }
+
+        public bool TryRead(Vector2 at, out GroundHit result)
+        {
+            result = default;
+            if (!scene.Raycast(new Vector3(at.x, 2.65f, at.y), Vector3.down, out var hit, 4.3f,
+                    Physics.DefaultRaycastLayers, QueryTriggerInteraction.Ignore) || hit.normal.y < .89f ||
+                hit.triangleIndex < 0 || hit.collider is not MeshCollider collider || !collider.sharedMesh)
+                return false;
+
+            if (!receivers.TryGetValue(collider, out var entry))
+            {
+                Mesh mesh = collider.sharedMesh;
+                var renderer = collider.GetComponent<MeshRenderer>();
+                var filter = collider.GetComponent<MeshFilter>();
+                int running = 0;
+                var ends = new int[mesh.subMeshCount];
+                for (int index = 0; index < ends.Length; index++)
+                {
+                    running += (int)mesh.GetIndexCount(index) / 3;
+                    ends[index] = running;
+                }
+                entry = renderer && renderer.enabled && filter && filter.sharedMesh == mesh
+                    ? (renderer, renderer.sharedMaterials, ends)
+                    : (null, Array.Empty<Material>(), ends);
+                receivers.Add(collider, entry);
+            }
+
+            for (int index = 0; index < Mathf.Min(entry.materials.Length, entry.end.Length); index++)
+            {
+                if (hit.triangleIndex >= entry.end[index])
+                    continue;
+                var material = entry.materials[index];
+                if (!material || material == main || collider.sharedMesh.name == "ReferenceRoad" ||
+                    !(material.name.Contains("Asphalt", StringComparison.OrdinalIgnoreCase) ||
+                      material.shader.name == "Street/Asphalt020S" && material.name.StartsWith("Court 7 · ", StringComparison.Ordinal)) ||
+                    material.name.Contains("Arris", StringComparison.OrdinalIgnoreCase) ||
+                    material.name.Contains("Seam", StringComparison.OrdinalIgnoreCase) ||
+                    material.name.Contains("Repair", StringComparison.OrdinalIgnoreCase))
+                    return false;
+                result = new GroundHit(collider, entry.renderer, material, index, hit.point.y);
+                return true;
+            }
+            return false;
+        }
+
+        public bool TryFootprint(Vector2 center, Vector2 along, Vector2 size, GroundHit? expected, out Footprint result)
+        {
+            result = default;
+            if (!TryRead(center, out var reference) || expected.HasValue && !reference.SameSurface(expected.Value))
+                return false;
+            Vector2 across = Across(along);
+            float low = reference.Height, high = reference.Height;
+            int acrossSteps = Mathf.Max(2, Mathf.CeilToInt(size.x / .44f));
+            int alongSteps = Mathf.Max(3, Mathf.CeilToInt(size.y / .52f));
+            for (int x = 0; x <= acrossSteps; x++)
+            for (int y = 0; y <= alongSteps; y++)
+            {
+                float lateral = (x / (float)acrossSteps - .5f) * (size.x + .07f);
+                float station = (y / (float)alongSteps - .5f) * (size.y + .07f);
+                if (!TryRead(center + across * lateral + along * station, out var sample) || !reference.SameSurface(sample))
+                    return false;
+                low = Mathf.Min(low, sample.Height);
+                high = Mathf.Max(high, sample.Height);
+                if (high - low > .086f)
+                    return false;
+            }
+
+            result = new Footprint(reference, new Vector3(center.x, (low + high) * .5f, center.y),
+                along, size, high - low + .028f);
+            return true;
+        }
+    }
+}
