new file mode 100644
index 0000000000000000000000000000000000000000..f30ad89ab16272e842e690351bfe3a460f454975
--- /dev/null
+++ b/Assets/StreetHDRP/CourtAsphalt/CourtAsphaltVariation.hlsl
@@ -0,0 +1,55 @@
+#ifndef STREET_COURT_ASPHALT_VARIATION_INCLUDED
+#define STREET_COURT_ASPHALT_VARIATION_INCLUDED
+
+float CourtAsphaltHash(float2 position)
+{
+    float3 value = frac(position.xyx * float3(.1031, .1030, .0973));
+    value += dot(value, value.yzx + 33.33);
+    return frac((value.x + value.y) * value.z);
+}
+
+float CourtAsphaltNoise(float2 position)
+{
+    float2 cell = floor(position);
+    float2 t = frac(position);
+    t = t * t * (3.0 - 2.0 * t);
+    return lerp(lerp(CourtAsphaltHash(cell), CourtAsphaltHash(cell + float2(1, 0)), t.x),
+                lerp(CourtAsphaltHash(cell + float2(0, 1)), CourtAsphaltHash(cell + 1.0), t.x), t.y);
+}
+
+void ApplyCourtAsphaltVariation(float2 worldXZ, float2 uv, inout StreetSurfaceSample surface)
+{
+    if (_CourtAsphaltDimensions.x <= 0.0) return;
+
+    float2 relative = worldXZ - _CourtAsphaltAxis.xy;
+    float along = dot(relative, _CourtAsphaltAxis.zw);
+    float across = dot(relative, float2(_CourtAsphaltAxis.w, -_CourtAsphaltAxis.z));
+    float endDistance = min(along, _CourtAsphaltDimensions.x - along);
+    float edgeDistance = .5 * _CourtAsphaltDimensions.y - abs(across);
+    if (min(endDistance, edgeDistance) <= 0.0) return;
+
+    float borderNoise = CourtAsphaltNoise(worldXZ * .77 + float2(13.7, 42.9));
+    float margin = lerp(.07, .31, borderNoise);
+    float fade = smoothstep(margin, _CourtAsphaltDimensions.z, endDistance) *
+                 smoothstep(margin, _CourtAsphaltDimensions.w, edgeDistance);
+    float broad = CourtAsphaltNoise(worldXZ * float2(.27, .33) + float2(4.8, 57.2));
+    float medium = CourtAsphaltNoise(worldXZ * float2(.66, .79) + float2(19.1, 23.6));
+    float aged = smoothstep(.23, .75, broad * .70 + medium * .30);
+    float2 alternate = float2(-uv.y, uv.x) * .77 + float2(.37, .91);
+    float mixTile = smoothstep(.19, .80, medium);
+    float3 stone = STREET_SAMPLE(_MainTex, alternate).rgb * _Color.rgb * _ToneGain.rgb;
+    float3 aggregate = lerp(surface.Albedo, stone, mixTile * .72);
+    float3 agedTone = lerp(float3(.71, .75, .80), float3(1.24, 1.22, 1.18), aged);
+    float wander = (CourtAsphaltNoise(float2(along * .31, across * .43)) - .5) * .27;
+    float wheelEdge = abs(abs(across + wander) - min(.77, _CourtAsphaltDimensions.y * .25));
+    float wheel = (1.0 - smoothstep(.11, .44, wheelEdge)) * lerp(.4, .95, medium);
+    float grit = (1.0 - smoothstep(.17, .77, edgeDistance)) * smoothstep(.3, .72, medium);
+    float3 color = aggregate * agedTone * (1.0 - .15 * wheel);
+    color = lerp(color, aggregate * float3(1.26, 1.17, 1.03), grit * .55);
+    float roughness = lerp(1.0 - surface.Smoothness, STREET_SAMPLE(_MaskMap, alternate).g, mixTile * .65);
+    roughness = clamp(roughness + .17 * aged - .13 * wheel + .09 * grit, .22, .96);
+    surface.Albedo = lerp(surface.Albedo, color, fade);
+    surface.Smoothness = lerp(surface.Smoothness, 1.0 - roughness, fade);
+}
+
+#endif
