@@ -0,0 +1,445 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using UnityEditor;
+using UnityEngine;
+using UnityEngine.Rendering;
+using UnityEngine.SceneManagement;
+using Object = UnityEngine.Object;
+using Random = System.Random;
+
+internal static class StreetCourtVarietyGrass
+{
+    private const string Folder = "Assets/StreetHDRP/CourtVarietyGrass";
+    private const string ExistingGround = "Assets/Art/AutumnGrass/Raised lawn ground.mat";
+    private const string ExistingGrass = "Assets/Art/AutumnGrass/DenseLawn/Lawn HDRP Instanced.mat";
+    private const string RaisedMeshes = "Assets/PhotoReconstruction/Stage05Civil/Meshes";
+    private const string ExistingTerrain = "Assets/StreetHDRP/DistrictPlanting";
+    private const float Grid = .26f;
+    private const float ChunkSize = 7f;
+
+    private readonly struct Growth
+    {
+        public readonly float Green, Wear, Dry;
+        public Growth(float green, float wear, float dry) => (Green, Wear, Dry) = (green, wear, dry);
+    }
+
+    private sealed class Lawn
+    {
+        public MeshCollider Collider;
+        public MeshRenderer Renderer;
+        public int Slot, FirstTriangle, EndTriangle;
+        public Bounds Top;
+    }
+
+    private sealed class Batch
+    {
+        public readonly MeadowMesh Near = new();
+        public readonly MeadowMesh Far = new();
+    }
+
+    public static string Apply(Scene scene, Transform parent)
+    {
+        var lawnMaterial = AssetDatabase.LoadAssetAtPath<Material>(ExistingGround);
+        var blades = AssetDatabase.LoadAssetAtPath<Material>(ExistingGrass);
+        if (!lawnMaterial || !blades || !lawnMaterial.HasProperty("_CourtTurfVariation"))
+            throw new InvalidOperationException("Court grass source materials or the turf shader properties are missing.");
+        if (!AssetDatabase.IsValidFolder(Folder))
+            AssetDatabase.CreateFolder("Assets/StreetHDRP", "CourtVarietyGrass");
+
+        var ground = MaterialVariant("Court №7 · Living turf and worn soil", lawnMaterial);
+        var foliage = MaterialVariant("Court №7 · Mixed blades and weeds", blades);
+        foliage.SetFloat("_Grass", 2f);
+        foliage.SetFloat("_BumpStrength", .08f);
+        foliage.SetColor("_Color", Color.white);
+        foliage.SetFloat("_AutumnAmount", 0);
+        foliage.SetFloat("_MeadowKeep", 1);
+        foliage.SetTexture("_MainTex", null);
+        EditorUtility.SetDirty(foliage);
+
+        var filters = Object.FindObjectsByType<MeshFilter>().Where(filter => filter.gameObject.scene == scene)
+            .ToLookup(filter => filter.sharedMesh);
+        var lawns = Enumerable.Range(0, 3).Select(index =>
+            ReadLawn(filters, index, lawnMaterial, ground)).ToArray();
+        Bounds court = lawns[0].Top;
+        foreach (var lawn in lawns)
+            court.Encapsulate(lawn.Top);
+        court.Expand(.75f);
+        ground.SetTexture("_CourtTurfPartition", BakePartition(court));
+        ground.SetVector("_CourtTurfBounds", new Vector4(court.min.x, court.min.z, 1 / court.size.x, 1 / court.size.z));
+        ground.SetFloat("_CourtTurfVariation", 1f);
+        ground.SetFloat("_MeadowDrying", 0f);
+        EditorUtility.SetDirty(ground);
+
+        Physics.SyncTransforms();
+        var physics = scene.GetPhysicsScene();
+        var amended = ToneDownOriginalDetails(scene, physics, lawns, court);
+        var batches = new Dictionary<Vector2Int, Batch>();
+        int[] planted = new int[4];
+        for (int island = 0; island < lawns.Length; island++)
+        {
+            var lawn = lawns[island];
+            var random = new Random(7109 + island * 377);
+            for (float z = lawn.Top.min.z; z < lawn.Top.max.z; z += Grid)
+            for (float x = lawn.Top.min.x; x < lawn.Top.max.x; x += Grid)
+            {
+                Vector3 point = new(x + Between(random, -.10f, .10f), 0, z + Between(random, -.10f, .10f));
+                if (!Hit(physics, point.x, point.z, lawn, out var hit))
+                    continue;
+                float edge = .10f;
+                if (!Hit(physics, point.x + edge, point.z, lawn, out _) ||
+                    !Hit(physics, point.x - edge, point.z, lawn, out _) ||
+                    !Hit(physics, point.x, point.z + edge, lawn, out _) ||
+                    !Hit(physics, point.x, point.z - edge, lawn, out _))
+                    continue;
+                var growth = Field(point.x, point.z);
+                if (random.NextDouble() > Mathf.Lerp(.35f, .96f, growth.Green) * (1 - growth.Wear * .91f))
+                    continue;
+
+                var chunk = new Vector2Int(Mathf.FloorToInt(point.x / ChunkSize), Mathf.FloorToInt(point.z / ChunkSize));
+                if (!batches.TryGetValue(chunk, out var batch))
+                    batches.Add(chunk, batch = new Batch());
+                float roll = (float)random.NextDouble();
+                if (growth.Wear + growth.Dry > .64f && roll < .50f)
+                {
+                    AddTuft(batch, hit.point, random, 2, growth.Green);
+                    planted[2]++;
+                }
+                else if (roll > .955f && growth.Wear < .38f && growth.Dry > .20f)
+                {
+                    AddTuft(batch, hit.point, random, 3, growth.Green);
+                    planted[3]++;
+                }
+                else
+                {
+                    int style = growth.Green > .56f && roll > .28f ? 1 : 0;
+                    AddTuft(batch, hit.point, random, style, growth.Green);
+                    planted[style]++;
+                }
+            }
+        }
+
+        if (planted.Any(count => count < 8))
+            throw new InvalidOperationException("The selected lawn did not generate each requested vegetation type.");
+        foreach (var (cell, batch) in batches.OrderBy(entry => entry.Key.x).ThenBy(entry => entry.Key.y))
+            AddBatch(parent, cell, batch, foliage);
+        foreach (var lawn in lawns)
+            Debug.Log($"COURT_VARIETY_GRASS_OBJECT {lawn.Renderer.name} | {lawn.Renderer.GetComponent<MeshFilter>().sharedMesh.name} | slot={lawn.Slot}");
+        return $"grassMeshes={lawns.Length}, lawnTerrains={amended.tiles}, suppressedOldTufts={amended.removed}, " +
+            $"grassChunks={batches.Count}, closeTriangles={batches.Values.Sum(batch => batch.Near.Triangles.Count / 3)}, " +
+            $"Fine grass={planted[0]}, Wide grass={planted[1]}, Dry grass={planted[2]}, Rosettes={planted[3]}";
+    }
+
+    private static Lawn ReadLawn(ILookup<Mesh, MeshFilter> filters, int index, Material baseline, Material variant)
+    {
+        var source = AssetDatabase.LoadAssetAtPath<Mesh>($"{RaisedMeshes}/IslandRelief05_{index}.asset");
+        if (!source)
+            throw new InvalidOperationException($"Missing the saved lawn island {index}.");
+        var filter = filters[source].Single();
+        var collider = filter.GetComponent<MeshCollider>();
+        var renderer = filter.GetComponent<MeshRenderer>();
+        if (!collider || !collider.enabled || collider.sharedMesh != source || !renderer || !renderer.enabled)
+            throw new InvalidOperationException($"Lawn island {filter.name} lacks a live renderer or collider.");
+        var materials = renderer.sharedMaterials;
+        int slot = Array.FindIndex(materials, material => material == baseline || material == variant);
+        if (slot < 0 || slot >= source.subMeshCount || source.GetIndexCount(slot) == 0)
+            throw new InvalidOperationException($"Unknown grass submesh on {filter.name}.");
+        int first = 0;
+        for (int i = 0; i < slot; i++)
+            first += (int)source.GetIndexCount(i) / 3;
+        var vertices = source.vertices;
+        var topIndices = source.GetTriangles(slot);
+        var bounds = new Bounds(filter.transform.TransformPoint(vertices[topIndices[0]]), Vector3.zero);
+        foreach (int vertex in topIndices)
+            bounds.Encapsulate(filter.transform.TransformPoint(vertices[vertex]));
+        Undo.RecordObject(renderer, "Apply court lawn material");
+        materials[slot] = variant;
+        renderer.sharedMaterials = materials;
+        return new Lawn
+        {
+            Collider = collider, Renderer = renderer, Slot = slot, Top = bounds,
+            FirstTriangle = first, EndTriangle = first + topIndices.Length / 3
+        };
+    }
+
+    private static bool Hit(PhysicsScene physics, float x, float z, Lawn lawn, out RaycastHit hit)
+    {
+        float top = lawn.Top.max.y + 1.2f;
+        return physics.Raycast(new Vector3(x, top, z), Vector3.down, out hit, top - lawn.Top.min.y + .12f,
+            Physics.DefaultRaycastLayers, QueryTriggerInteraction.Ignore) &&
+            hit.collider == lawn.Collider && hit.normal.y > .76f &&
+            hit.triangleIndex >= lawn.FirstTriangle && hit.triangleIndex < lawn.EndTriangle;
+    }
+
+    private static Growth Field(float x, float z)
+    {
+        float meandering = Mathf.PerlinNoise(x * .31f + 5.3f, z * .27f + 2.9f);
+        float meadow = Mathf.PerlinNoise(x * .137f + 14.8f, z * .156f + 29.1f);
+        float green = Mathf.SmoothStep(0, 1, Mathf.InverseLerp(.27f, .72f, .69f * meadow + .31f * meandering));
+        float erosion = Mathf.PerlinNoise(x * .70f + 6.2f, z * .66f + 26.1f);
+        // Replicate ordinary patch repair around the lamp and dry ends of the small islands.
+        float worn = Mathf.Max(Room(x, z, 43.45f, 44.00f, 1.6f, 1.1f),
+            Room(x, z, 46.8f, 39.74f, 1.8f, .85f), Room(x, z, 34.7f, 35.3f, 1.4f, .95f));
+        float localWear = Mathf.SmoothStep(0, 1, Mathf.InverseLerp(.42f, .92f, worn + (erosion - .5f) * .63f));
+        float dry = Mathf.SmoothStep(0, 1, Mathf.InverseLerp(.43f, .77f,
+            .52f * (1 - green) + .34f * erosion + .30f * localWear));
+        return new Growth(green, localWear, dry);
+    }
+
+    private static float Room(float x, float z, float cx, float cz, float rx, float rz)
+    {
+        var distance = new Vector2((x - cx) / rx, (z - cz) / rz).magnitude;
+        return Mathf.Clamp01(1.32f - distance * .73f);
+    }
+
+    private static Texture2D BakePartition(Bounds court)
+    {
+        const int size = 256;
+        string path = $"{Folder}/Court turf growth and wear.png";
+        var texture = new Texture2D(size, size, TextureFormat.RGBA32, false, true);
+        var pixels = new Color[size * size];
+        for (int z = 0; z < size; z++)
+        for (int x = 0; x < size; x++)
+        {
+            var growth = Field(court.min.x + (x + .5f) * court.size.x / size,
+                court.min.z + (z + .5f) * court.size.z / size);
+            pixels[z * size + x] = new Color(growth.Green, growth.Wear, growth.Dry, 1f);
+        }
+        texture.SetPixels(pixels);
+        texture.Apply(false);
+        byte[] png = texture.EncodeToPNG();
+        Object.DestroyImmediate(texture);
+        bool changed = !File.Exists(path) || !File.ReadAllBytes(path).SequenceEqual(png);
+        if (changed)
+        {
+            File.WriteAllBytes(path, png);
+            AssetDatabase.ImportAsset(path, ImportAssetOptions.ForceSynchronousImport);
+        }
+        var importer = (TextureImporter)AssetImporter.GetAtPath(path);
+        if (importer.sRGBTexture || importer.wrapMode != TextureWrapMode.Clamp ||
+            importer.textureCompression != TextureImporterCompression.Uncompressed || !importer.mipmapEnabled)
+        {
+            importer.sRGBTexture = false;
+            importer.wrapMode = TextureWrapMode.Clamp;
+            importer.textureCompression = TextureImporterCompression.Uncompressed;
+            importer.mipmapEnabled = true;
+            importer.SaveAndReimport();
+        }
+        return AssetDatabase.LoadAssetAtPath<Texture2D>(path);
+    }
+
+    private static (int tiles, int removed) ToneDownOriginalDetails(Scene scene, PhysicsScene physics, Lawn[] lawns, Bounds court)
+    {
+        int tiles = 0, removed = 0;
+        foreach (var terrain in Object.FindObjectsByType<Terrain>().Where(terrain => terrain.gameObject.scene == scene
+                     && !terrain.drawHeightmap && terrain.drawTreesAndFoliage && terrain.terrainData
+                     && terrain.name.StartsWith("Lawn_", StringComparison.Ordinal)))
+        {
+            Vector3 origin = terrain.transform.position;
+            Vector3 extent = terrain.terrainData.size;
+            if (origin.x + extent.x < court.min.x || origin.z + extent.z < court.min.z ||
+                origin.x > court.max.x || origin.z > court.max.z)
+                continue;
+            var source = AssetDatabase.LoadAssetAtPath<TerrainData>($"{ExistingTerrain}/{terrain.name}.asset");
+            if (!source || source.detailWidth != terrain.terrainData.detailWidth ||
+                source.detailHeight != terrain.terrainData.detailHeight)
+                throw new InvalidOperationException($"Missing the existing instanced lawn source {terrain.name}.");
+            var maps = Enumerable.Range(0, source.detailPrototypes.Length).Select(index =>
+                source.GetDetailLayer(0, 0, source.detailWidth, source.detailHeight, index)).ToArray();
+            float dx = extent.x / source.detailWidth, dz = extent.z / source.detailHeight;
+            int edited = 0;
+            for (int z = 0; z < source.detailHeight; z++)
+            for (int x = 0; x < source.detailWidth; x++)
+            {
+                int count = maps.Sum(map => map[z, x]);
+                if (count == 0) continue;
+                float wx = origin.x + (x + .5f) * dx, wz = origin.z + (z + .5f) * dz;
+                var growth = Field(wx, wz);
+                if (Hash(x, z) > Mathf.Lerp(.82f, .42f, growth.Green) + growth.Wear * .22f)
+                    continue;
+                if (!lawns.Any(lawn => wx >= lawn.Top.min.x && wx <= lawn.Top.max.x && wz >= lawn.Top.min.z &&
+                        wz <= lawn.Top.max.z && Hit(physics, wx, wz, lawn, out _)))
+                    continue;
+                foreach (var map in maps)
+                    map[z, x] = 0;
+                edited += count;
+            }
+            if (edited == 0) continue;
+            string path = $"{Folder}/{terrain.name} court detail.asset";
+            var data = AssetDatabase.LoadAssetAtPath<TerrainData>(path);
+            if (!data)
+            {
+                data = Object.Instantiate(source);
+                data.name = terrain.name + " court detail";
+                AssetDatabase.CreateAsset(data, path);
+            }
+            for (int index = 0; index < maps.Length; index++)
+                data.SetDetailLayer(0, 0, index, maps[index]);
+            Undo.RecordObject(terrain, "Replace the court lawn detail density");
+            terrain.terrainData = data;
+            EditorUtility.SetDirty(data);
+            tiles++;
+            removed += edited;
+            Debug.Log($"COURT_VARIETY_GRASS_TERRAIN {terrain.name} | {path} | removed={edited}");
+        }
+        return (tiles, removed);
+    }
+
+    private static float Hash(int x, int z)
+    {
+        unchecked
+        {
+            uint h = ((uint)x * 50331653u + (uint)z * 1610612741u + 631u) * 2654435761u;
+            h ^= h >> 15;
+            return (h & 0x00ffffffu) / 16777216f;
+        }
+    }
+
+    private static Material MaterialVariant(string name, Material baseline)
+    {
+        string path = $"{Folder}/{name.Replace(" · ", " ").Replace("№", "No")}.mat";
+        var material = AssetDatabase.LoadAssetAtPath<Material>(path);
+        if (!material)
+        {
+            material = new Material(baseline) { name = name };
+            AssetDatabase.CreateAsset(material, path);
+        }
+        return material;
+    }
+
+    private static void AddTuft(Batch batch, Vector3 point, Random random, int style, float richness)
+    {
+        int count = style switch { 1 => 8, 2 => 5, 3 => 7, _ => 7 };
+        var scale = Between(random, .76f, 1.19f);
+        var rotation = Between(random, 0f, 2f * Mathf.PI);
+        var color = style switch
+        {
+            1 => Color.Lerp(new Color(.084f, .15f, .037f), new Color(.147f, .233f, .054f), richness),
+            2 => new Color(.247f, .181f, .055f),
+            3 => new Color(.085f, .17f, .042f),
+            _ => Color.Lerp(new Color(.119f, .18f, .047f), new Color(.17f, .253f, .073f), richness)
+        };
+        for (int index = 0; index < count; index++)
+        {
+            float heading = rotation + index * 2.39996f + Between(random, -.37f, .37f);
+            var forward = new Vector3(Mathf.Cos(heading), 0, Mathf.Sin(heading));
+            float length, lean, width;
+            switch (style)
+            {
+                case 1: length = Between(random, .092f, .194f); lean = Between(random, .032f, .071f); width = .009f; break;
+                case 2: length = Between(random, .142f, .265f); lean = Between(random, .045f, .090f); width = .004f; break;
+                case 3: length = Between(random, .040f, .084f); lean = Between(random, .069f, .132f); width = .017f; break;
+                default: length = Between(random, .055f, .127f); lean = Between(random, .020f, .055f); width = .0045f; break;
+            }
+            Vector3 root = point + forward * Between(random, .006f, .037f) - Vector3.up * .006f;
+            Color shade = color * Between(random, .74f, 1.16f);
+            batch.Near.AddBlade(root, forward, length * scale, lean * scale, width * scale,
+                shade, style == 2, style == 3, false);
+            if (index % 2 == 0)
+                batch.Far.AddBlade(root, forward, length * scale, lean * scale, width * scale * 1.33f,
+                    shade, style == 2, style == 3, true);
+        }
+    }
+
+    private static float Between(Random source, float min, float max) => Mathf.Lerp(min, max, (float)source.NextDouble());
+
+    private static void AddBatch(Transform parent, Vector2Int cell, Batch batch, Material grass)
+    {
+        string name = $"Court grass {cell.x}_{cell.y}";
+        var root = new GameObject(name);
+        root.transform.SetParent(parent, false);
+        var center = new Vector3((cell.x + .5f) * ChunkSize, 0, (cell.y + .5f) * ChunkSize);
+        root.transform.position = center;
+        var near = AddRenderer(root.transform, batch.Near, grass, name + " near", center);
+        var far = AddRenderer(root.transform, batch.Far, grass, name + " far", center);
+        var lod = root.AddComponent<LODGroup>();
+        lod.fadeMode = LODFadeMode.CrossFade;
+        lod.animateCrossFading = false;
+        lod.SetLODs(new[]
+        {
+            new LOD(.26f, new Renderer[] { near }) { fadeTransitionWidth = .12f },
+            new LOD(.085f, new Renderer[] { far }) { fadeTransitionWidth = .20f }
+        });
+        lod.RecalculateBounds();
+    }
+
+    private static MeshRenderer AddRenderer(Transform parent, MeadowMesh meadow, Material grass, string name, Vector3 center)
+    {
+        string path = $"{Folder}/{name}.asset";
+        var mesh = AssetDatabase.LoadAssetAtPath<Mesh>(path);
+        if (!mesh)
+        {
+            mesh = new Mesh { name = name };
+            AssetDatabase.CreateAsset(mesh, path);
+        }
+        mesh.Clear();
+        mesh.SetVertices(meadow.Vertices.Select(vertex => vertex - center).ToList());
+        mesh.SetColors(meadow.Colors);
+        mesh.SetNormals(meadow.Normals);
+        mesh.SetTangents(meadow.Tangents);
+        mesh.SetUVs(0, meadow.UV);
+        mesh.SetTriangles(meadow.Triangles, 0);
+        var bounds = mesh.bounds;
+        bounds.Expand(.13f);
+        mesh.bounds = bounds;
+        EditorUtility.SetDirty(mesh);
+
+        var node = new GameObject(name);
+        node.transform.SetParent(parent, false);
+        node.AddComponent<MeshFilter>().sharedMesh = mesh;
+        var renderer = node.AddComponent<MeshRenderer>();
+        renderer.sharedMaterial = grass;
+        renderer.shadowCastingMode = ShadowCastingMode.Off;
+        renderer.lightProbeUsage = LightProbeUsage.BlendProbes;
+        renderer.reflectionProbeUsage = ReflectionProbeUsage.Off;
+        renderer.motionVectorGenerationMode = MotionVectorGenerationMode.ForceNoMotion;
+        return renderer;
+    }
+
+    private sealed class MeadowMesh
+    {
+        public readonly List<Vector3> Vertices = new();
+        public readonly List<Vector3> Normals = new();
+        public readonly List<Vector4> Tangents = new();
+        public readonly List<Color> Colors = new();
+        public readonly List<Vector2> UV = new();
+        public readonly List<int> Triangles = new();
+
+        public void AddBlade(Vector3 origin, Vector3 forward, float height, float lean,
+            float halfWidth, Color color, bool dry, bool broad, bool reduced)
+        {
+            var across = Vector3.Cross(Vector3.up, forward);
+            var normal = (Vector3.up * 1.2f + forward * (broad ? .16f : .78f)).normalized;
+            int start = Vertices.Count;
+            int segments = reduced ? 1 : 2;
+            for (int row = 0; row <= segments; row++)
+            {
+                float t = (float)row / segments * .75f;
+                float width = halfWidth * (broad ? Mathf.Lerp(.42f, 1.16f, Mathf.Sin(t * Mathf.PI))
+                    : 1 - .54f * t);
+                Vector3 position = origin + forward * (lean * t * t) + Vector3.up * (height * t);
+                Color tinted = color * Mathf.Lerp(.51f, 1.15f, t);
+                Put(position - across * width, normal, across, tinted, new Vector2(0, t));
+                Put(position + across * width, normal, across, tinted, new Vector2(1, t));
+                if (row == 0) continue;
+                int begin = start + 2 * (row - 1);
+                Triangles.Add(begin); Triangles.Add(begin + 2); Triangles.Add(begin + 1);
+                Triangles.Add(begin + 1); Triangles.Add(begin + 2); Triangles.Add(begin + 3);
+            }
+            Vector3 tip = origin + forward * lean + Vector3.up * (height * (broad ? .87f : 1));
+            Put(tip, normal, across, color * (dry ? 1.44f : 1.22f), new Vector2(.5f, 1));
+            int end = Vertices.Count - 1;
+            Triangles.Add(end - 2); Triangles.Add(end); Triangles.Add(end - 1);
+        }
+
+        private void Put(Vector3 position, Vector3 normal, Vector3 tangent, Color color, Vector2 uv)
+        {
+            Vertices.Add(position);
+            Normals.Add(normal);
+            Tangents.Add(new Vector4(tangent.x, tangent.y, tangent.z, -1));
+            Colors.Add(new Color(color.r, color.g, color.b, 1));
+            UV.Add(uv);
+        }
+    }
+}
