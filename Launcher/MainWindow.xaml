<Window x:Class="Pereulki.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:visuals="clr-namespace:Pereulki.Launcher.Visuals"
        xmlns:controls="clr-namespace:Pereulki.Launcher.Controls"
        xmlns:views="clr-namespace:Pereulki.Launcher.Views"
        Title="Переулки" Width="1216" Height="792" MinWidth="862" MinHeight="650"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#000000" Foreground="{StaticResource Ink}"
        Icon="Assets/Pereulki.ico" FontFamily="Segoe UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" AutomationProperties.Name="Лаунчер игры Переулки">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="19"/>
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="Shell">
        <Grid x:Name="AmbientBackdrop" Background="#000000" IsHitTestVisible="False">
            <visuals:AmbientGlow x:Name="Glow"/>
            <Border Height="122" VerticalAlignment="Top">
                <Border.Background>
                    <RadialGradientBrush Center=".93,0" GradientOrigin=".95,-.35" RadiusX=".41" RadiusY=".78">
                        <GradientStop Offset="0" Color="#396D537C"/>
                        <GradientStop Offset="1" Color="#006D537C"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
        </Grid>

        <Grid controls:GlassBackdrop.Source="{Binding ElementName=AmbientBackdrop}">
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="28,0,18,0">
                    <Path Data="{StaticResource StreetMark}" Stroke="{StaticResource Brass}" StrokeThickness="1.35"
                          StrokeLineJoin="Round" Width="18" Height="22" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="TopVersion" Foreground="{StaticResource Dim}" FontFamily="{StaticResource Mono}"
                                   FontSize="11" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource ChromeButton}" Click="Minimize_Click" ToolTip="Свернуть"
                                AutomationProperties.Name="Свернуть окно" Margin="0,0,5,0">
                            <Path Data="M 1,6 L 11,6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.25" Width="12" Height="12"/>
                        </Button>
                        <Button Style="{StaticResource ChromeButton}" Click="Maximize_Click" ToolTip="Размер окна"
                                AutomationProperties.Name="Развернуть или восстановить окно" Margin="0,0,5,0">
                            <Path x:Name="MaximizeGlyph" Data="M 2,2 L 10,2 10,10 2,10 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.15" Width="12" Height="12"/>
                        </Button>
                        <Button Style="{StaticResource ChromeButton}" Click="Close_Click" ToolTip="Закрыть"
                                AutomationProperties.Name="Закрыть окно">
                            <Path Data="{StaticResource CloseMark}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3" Width="12" Height="12"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="MainScene" Grid.Row="1" MaxWidth="1776" Margin="26,8,26,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="111"/>
                </Grid.RowDefinitions>

                <Grid x:Name="GallerySurface">
                    <controls:RoundedClip.Radius>21</controls:RoundedClip.Radius>
                    <visuals:GameGallery x:Name="Gallery" AutomationProperties.Name="Галерея игровых кадров"/>
                    <controls:Wordmark x:Name="GalleryWordmark" Width="352" Height="62" Margin="28,19,0,0"
                                       HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
                    <Grid VerticalAlignment="Bottom" Margin="25,0,197,23" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FrameIndex" Foreground="#FADDBF" FontFamily="{StaticResource Mono}"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,13,0"/>
                        <TextBlock x:Name="FrameCaption" Grid.Column="1" Foreground="{StaticResource Ink}" FontSize="14"
                                   FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,17,15" controls:GlassBackdrop.Source="{Binding ElementName=Gallery}">
                        <Button x:Name="PreviousFrame" Style="{StaticResource ChromeButton}" IsEnabled="False"
                                Width="39" Height="35" Margin="0,0,6,0" Click="PreviousFrame_Click"
                                ToolTip="Предыдущий кадр" AutomationProperties.Name="Предыдущий кадр">
                            <Path Data="M 8,1 L 2,7 8,13" Stroke="{StaticResource Ink}" StrokeThickness="1.5"
                                  StrokeLineJoin="Round" Width="10" Height="14"/>
                        </Button>
                        <Button x:Name="NextFrame" Style="{StaticResource ChromeButton}" IsEnabled="False"
                                Width="39" Height="35" Click="NextFrame_Click"
                                ToolTip="Следующий кадр" AutomationProperties.Name="Следующий кадр">
                            <Path Data="M 2,1 L 8,7 2,13" Stroke="{StaticResource Ink}" StrokeThickness="1.5"
                                  StrokeLineJoin="Round" Width="10" Height="14"/>
                        </Button>
                    </StackPanel>
                    <Border BorderBrush="#65C4B9C6" BorderThickness="1" CornerRadius="21" IsHitTestVisible="False"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button x:Name="PlayButton" Click="Play_Click" Style="{StaticResource PrimaryButton}" Width="212"
                            HorizontalAlignment="Left" AutomationProperties.Name="Играть">
                        <Grid Width="164">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="25"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="19"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="M 2,1 L 2,15 14,8 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="ИГРАТЬ" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            <Path Grid.Column="2" Data="{StaticResource ArrowMark}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2" Width="16" Height="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="SettingsButton" Content="НАСТРОЙКИ" Click="Settings_Click" Style="{StaticResource PanelButton}"
                                FontSize="12" Width="124" Height="43" Margin="0,0,8,0"/>
                        <Button x:Name="UpdatesButton" Content="ОБНОВЛЕНИЯ" Click="Updates_Click" Style="{StaticResource PanelButton}"
                                FontSize="12" Width="128" Height="43" Margin="0,0,8,0"/>
                        <Button Content="ВЫХОД" Click="Close_Click" Style="{StaticResource PanelButton}"
                                FontSize="12" Width="76" Height="43"/>
                    </StackPanel>
                    <Grid Grid.Row="1" VerticalAlignment="Top" Margin="2,11,1,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="StatusDot" Width="5" Height="5" Margin="0,6,8,0" VerticalAlignment="Top"/>
                        <TextBlock x:Name="StatusText" Grid.Column="1" Foreground="{StaticResource Muted}" FontSize="12"
                                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    </Grid>
                </Grid>
            </Grid>

            <Grid x:Name="Overlay" Grid.Row="1" Visibility="Collapsed" Background="#B0000000"
                  KeyboardNavigation.TabNavigation="Cycle" MouseLeftButtonDown="Overlay_MouseLeftButtonDown">
                <Grid x:Name="Panel" Margin="20" Width="602" MaxHeight="600"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RenderTransform><TranslateTransform x:Name="PanelMotion"/></Grid.RenderTransform>
                    <Border x:Name="PanelGround" CornerRadius="21" BorderBrush="#6DAD98B5" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#F2251D2C"/>
                                <GradientStop Offset=".56" Color="#F2131018"/>
                                <GradientStop Offset="1" Color="#F22F202A"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border Background="Transparent" Padding="29,22,29,24" CornerRadius="21"
                            controls:GlassBackdrop.Source="{Binding ElementName=PanelGround}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,18">
                                <TextBlock x:Name="PanelTitle" FontSize="27" FontWeight="SemiBold" Margin="0,0,48,0" VerticalAlignment="Center"/>
                                <Button x:Name="PanelClose" Style="{StaticResource ChromeButton}" Click="PanelClose_Click"
                                        HorizontalAlignment="Right" ToolTip="Закрыть панель" AutomationProperties.Name="Закрыть панель">
                                    <Path Data="{StaticResource CloseMark}" Stroke="{StaticResource Ink}" StrokeThickness="1.4" Width="12" Height="12"/>
                                </Button>
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False" Padding="0,0,3,0">
                                <Grid>
                                    <views:SettingsView x:Name="SettingsPanel"/>
                                    <views:UpdatesView x:Name="UpdatesPanel"/>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
        <Border CornerRadius="19" BorderBrush="#6C827288" BorderThickness="1" IsHitTestVisible="False"/>
    </Grid>
</Window>
