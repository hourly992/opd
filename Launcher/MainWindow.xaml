<Window x:Class="Pereulki.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:visuals="clr-namespace:Pereulki.Launcher.Visuals"
        xmlns:controls="clr-namespace:Pereulki.Launcher.Controls"
        xmlns:views="clr-namespace:Pereulki.Launcher.Views"
        Title="Переулки" Width="1216" Height="792" MinWidth="862" MinHeight="650"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#000000" Foreground="{StaticResource Ink}"
        Icon="Assets/Pereulki.ico" FontFamily="Segoe UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" AutomationProperties.Name="Лаунчер игры Переулки">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="#39313C" BorderThickness="1" ClipToBounds="True">
        <Grid Background="#000000">
            <visuals:AmbientGlow x:Name="Glow" IsHitTestVisible="False"/>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#F0000000" BorderBrush="#252128" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="23,0,9,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,1">
                            <Path Data="{StaticResource StreetMark}" Stroke="{StaticResource Brass}" StrokeThickness="1.2"
                                  StrokeLineJoin="Round" Width="18" Height="22" VerticalAlignment="Center"/>
                            <TextBlock Text="ПЕРЕУЛКИ" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="TopVersion" Foreground="{StaticResource Dim}" FontFamily="{StaticResource Mono}"
                                       FontSize="11" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <Border Height="17" Background="{StaticResource Line}" Width="1" Margin="0,0,5,0"/>
                            <Button Style="{StaticResource ChromeButton}" Click="Minimize_Click" ToolTip="Свернуть"
                                    AutomationProperties.Name="Свернуть окно">
                                <Path Data="M 1,6 L 11,6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.25" Width="12" Height="12"/>
                            </Button>
                            <Button Style="{StaticResource ChromeButton}" Click="Maximize_Click" ToolTip="Размер окна"
                                    AutomationProperties.Name="Развернуть или восстановить окно">
                                <Path x:Name="MaximizeGlyph" Data="M 2,2 L 10,2 10,10 2,10 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.15" Width="12" Height="12"/>
                            </Button>
                            <Button Style="{StaticResource ChromeButton}" Click="Close_Click" ToolTip="Закрыть"
                                    AutomationProperties.Name="Закрыть окно">
                                <Path Data="{StaticResource CloseMark}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.3" Width="12" Height="12"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid x:Name="MainScene" Grid.Row="1" MaxWidth="1776" Margin="48,0,48,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="174"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="133"/>
                    </Grid.RowDefinitions>

                    <Grid x:Name="TitleComposition" Grid.Row="0" Margin="0,5,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="37"/>
                        </Grid.RowDefinitions>
                        <controls:Wordmark x:Name="Logo" Margin="8,5,8,0" MaxWidth="820" IsHitTestVisible="False"
                                           AutomationProperties.Name="Переулки"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid HorizontalAlignment="Right" Width="108" Margin="0,0,18,0" IsHitTestVisible="False">
                                <Path Data="M 0,12 L 22,12 28,6 106,6" Stroke="{StaticResource Line}"
                                      StrokeThickness="1" VerticalAlignment="Center"/>
                                <Path Data="M 102,3 L 105,6 102,9 99,6 Z" Stroke="{StaticResource Brass}"
                                      StrokeThickness="1" VerticalAlignment="Center"/>
                                <Ellipse x:Name="RoutePulse" Width="4" Height="4" Fill="{StaticResource Brass}"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,6,0,0">
                                    <Ellipse.RenderTransform><TranslateTransform x:Name="RouteMotion"/></Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <TextBlock Grid.Column="1" Text="У каждого двора своя история." FontSize="17"
                                       Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                            <Grid Grid.Column="2" HorizontalAlignment="Left" Width="108" Margin="18,0,0,0" IsHitTestVisible="False">
                                <Path Data="M 2,6 L 80,6 86,12 108,12" Stroke="{StaticResource Line}"
                                      StrokeThickness="1" VerticalAlignment="Center"/>
                                <Path Data="M 6,3 L 9,6 6,9 3,6 Z" Stroke="{StaticResource Brass}"
                                      StrokeThickness="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,1">
                            <Rectangle Width="7" Height="7" Stroke="{StaticResource Brass}" StrokeThickness="1"
                                       Margin="1,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ИГРОВЫЕ КАДРЫ" Foreground="{StaticResource Ink}" FontFamily="{StaticResource Mono}" FontSize="12"/>
                            <Border Width="1" Height="11" Background="{StaticResource Line}" Margin="13,0,13,0"/>
                            <TextBlock Text="ХАНТЫ-МАНСИЙСК" Foreground="{StaticResource Dim}" FontFamily="{StaticResource Mono}" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12,0,1,1">
                            <TextBlock x:Name="FrameCaption" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,-2,13,0"
                                       MaxWidth="330" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="FrameIndex" Foreground="{StaticResource Brass}" FontFamily="{StaticResource Mono}" FontSize="12"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" ClipToBounds="True">
                        <Border Background="#08070A" Padding="1">
                            <visuals:GameGallery x:Name="Gallery" AutomationProperties.Name="Галерея игровых кадров"/>
                        </Border>
                        <Border BorderBrush="#363038" BorderThickness="1" IsHitTestVisible="False"/>
                        <Path Data="M 1,13 L 1,1 13,1" Stroke="{StaticResource Brass}" StrokeThickness="1"
                              HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
                        <Path Data="M 1,13 L 13,13 13,1" Stroke="{StaticResource Brass}" StrokeThickness="1"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False"/>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,20,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="57"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button x:Name="PlayButton" Click="Play_Click" Style="{StaticResource PrimaryButton}" Width="226"
                                HorizontalAlignment="Left" AutomationProperties.Name="Играть">
                            <Grid Width="176">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="M 2,1 L 2,15 14,8 Z" Fill="#231B24" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="ИГРАТЬ" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                <Path Grid.Column="2" Data="{StaticResource ArrowMark}" Stroke="#5B4B51" StrokeThickness="1.2"
                                      Width="16" Height="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="SettingsButton" Content="НАСТРОЙКИ" Click="Settings_Click" Style="{StaticResource PanelButton}"
                                    FontSize="12" Width="124" Height="42" Margin="0,0,9,0"/>
                            <Button x:Name="UpdatesButton" Content="ОБНОВЛЕНИЯ" Click="Updates_Click" Style="{StaticResource PanelButton}"
                                    FontSize="12" Width="127" Height="42" Margin="0,0,9,0"/>
                            <Button Content="ВЫХОД" Click="Close_Click" Style="{StaticResource ButtonBase}" Foreground="{StaticResource Muted}"
                                    FontSize="12" Width="72" Height="42"/>
                        </StackPanel>
                        <Grid Grid.Row="1" VerticalAlignment="Top" Margin="1,13,1,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="StatusDot" Width="5" Height="5" Margin="0,6,8,0" VerticalAlignment="Top"/>
                            <TextBlock x:Name="StatusText" Grid.Column="1" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </Grid>
                    </Grid>
                </Grid>

                <Grid x:Name="Overlay" Grid.Row="1" Visibility="Collapsed" Background="#C9000000"
                      KeyboardNavigation.TabNavigation="Cycle" MouseLeftButtonDown="Overlay_MouseLeftButtonDown">
                    <Border x:Name="Panel" Margin="20" Width="598" MaxHeight="600" Padding="30,23,30,26"
                            Background="#0D0B10" BorderBrush="#413747" BorderThickness="1" CornerRadius="8"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.RenderTransform><TranslateTransform x:Name="PanelMotion"/></Border.RenderTransform>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,18">
                                <TextBlock x:Name="PanelTitle" FontSize="27" FontWeight="SemiBold" Margin="0,0,48,0" VerticalAlignment="Center"/>
                                <Button x:Name="PanelClose" Style="{StaticResource ChromeButton}" Click="PanelClose_Click"
                                        HorizontalAlignment="Right" ToolTip="Закрыть панель" AutomationProperties.Name="Закрыть панель">
                                    <Path Data="{StaticResource CloseMark}" Stroke="{StaticResource Muted}" StrokeThickness="1.4" Width="12" Height="12"/>
                                </Button>
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False" Padding="0,0,4,0">
                                <Grid>
                                    <views:SettingsView x:Name="SettingsPanel"/>
                                    <views:UpdatesView x:Name="UpdatesPanel"/>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
