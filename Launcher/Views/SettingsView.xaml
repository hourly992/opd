<UserControl x:Class="Pereulki.Launcher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Исполняемый файл игры" Style="{StaticResource PanelLabel}"/>
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="GamePathBox" Foreground="{StaticResource Ink}" Background="#17141A"
                     BorderBrush="#3D3640" BorderThickness="1" Padding="9,5" Height="36" VerticalContentAlignment="Center"
                     CaretBrush="{StaticResource Brass}" HorizontalScrollBarVisibility="Hidden"
                     AutomationProperties.Name="Исполняемый файл игры"/>
            <Button Grid.Column="1" Content="Обзор…" Style="{StaticResource PanelButton}" Click="Browse_Click"
                    Width="91" Margin="9,0,0,0"/>
        </Grid>
        <TextBlock x:Name="PathHint" Style="{StaticResource PanelHint}" Margin="0,7,0,0"/>
        <Border Height="1" Background="{StaticResource Line}" Margin="0,19,0,15"/>
        <CheckBox x:Name="AnimationsBox" Content="Анимации интерфейса" Foreground="{StaticResource Ink}"
                  FontSize="14" FontWeight="SemiBold" VerticalContentAlignment="Center" Padding="5,0,0,0"/>
        <TextBlock Text="Переходы кадров, движение света и плавное появление панелей." Style="{StaticResource PanelHint}"
                   Margin="19,6,0,15"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="234"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Качество эффектов" Style="{StaticResource PanelLabel}" VerticalAlignment="Center"/>
            <ComboBox x:Name="QualityBox" Grid.Column="1" Style="{StaticResource PanelCombo}"
                      AutomationProperties.Name="Качество эффектов">
                <ComboBoxItem Content="Высокое"/>
                <ComboBoxItem Content="Сниженное"/>
            </ComboBox>
        </Grid>
        <Grid Margin="0,9,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="234"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="После запуска игры" Style="{StaticResource PanelLabel}" VerticalAlignment="Center"/>
            <ComboBox x:Name="BehaviorBox" Grid.Column="1" Style="{StaticResource PanelCombo}"
                      AutomationProperties.Name="После запуска игры">
                <ComboBoxItem Content="Свернуть лаунчер"/>
                <ComboBoxItem Content="Оставить открытым"/>
                <ComboBoxItem Content="Закрыть лаунчер"/>
            </ComboBox>
        </Grid>
        <TextBlock x:Name="Issue" Foreground="{StaticResource Error}" TextWrapping="Wrap" Margin="0,12,0,0"
                   Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
        <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Click="Save_Click" HorizontalAlignment="Right"
                Width="129" Height="38" Margin="0,18,0,0"/>
    </StackPanel>
</UserControl>
