<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Pereulki.Launcher.Controls">
    <SolidColorBrush x:Key="Ink" Color="#F8F4F0"/>
    <SolidColorBrush x:Key="Muted" Color="#CBC2C5"/>
    <SolidColorBrush x:Key="Dim" Color="#A9A0AC"/>
    <SolidColorBrush x:Key="Line" Color="#42C9BDD5"/>
    <SolidColorBrush x:Key="Brass" Color="#F0BC96"/>
    <SolidColorBrush x:Key="Error" Color="#FFAD99"/>
    <SolidColorBrush x:Key="GlassFill" Color="#A6262330"/>
    <SolidColorBrush x:Key="GlassLine" Color="#66DDD1E3"/>
    <SolidColorBrush x:Key="GlassHoverLine" Color="#BDD6C7DC"/>
    <SolidColorBrush x:Key="FieldFill" Color="#AB14131B"/>
    <SolidColorBrush x:Key="PopupFill" Color="#F1221D29"/>
    <LinearGradientBrush x:Key="WarmGlass" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#ACA97358" Offset="0"/>
        <GradientStop Color="#A66D463B" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassHighlight" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1BFFFFFF" Offset="0"/>
        <GradientStop Color="#07FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <CornerRadius x:Key="ControlCorners">10</CornerRadius>
    <CornerRadius x:Key="PopupCorners">12</CornerRadius>
    <FontFamily x:Key="Mono">Consolas</FontFamily>
    <Geometry x:Key="StreetMark">M 1,17 L 1,6 7,3 7,14 M 10,14 L 10,1 16,4 16,17 M 1,20 L 7,17 10,17 16,20</Geometry>
    <Geometry x:Key="ArrowMark">M 1,6 L 14,6 M 9,1 L 14,6 9,11</Geometry>
    <Geometry x:Key="CloseMark">M 1,1 L 11,11 M 11,1 L 1,11</Geometry>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="MaxWidth" Value="400"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource PopupFill}" BorderBrush="{StaticResource GlassLine}"
                            BorderThickness="1" CornerRadius="{StaticResource PopupCorners}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ButtonBase" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{StaticResource GlassFill}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <controls:GlassBackdrop Radius="10"/>
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource ControlCorners}"/>
                        <Border x:Name="Highlight" CornerRadius="{StaticResource ControlCorners}"
                                Background="{StaticResource GlassHighlight}" Opacity="0" IsHitTestVisible="False"/>
                        <Border x:Name="PressedTint" CornerRadius="{StaticResource ControlCorners}"
                                Background="#0EEEC4A0" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource GlassHoverLine}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="controls:MotionSettings.IsEnabled" Value="True"/>
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Highlight" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                </Storyboard></BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Highlight" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" FillBehavior="Stop"/>
                                </Storyboard></BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="controls:MotionSettings.IsEnabled" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Highlight" Property="Opacity" Value="1"/>
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Brass}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Brass}"/>
                            <Setter TargetName="PressedTint" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Line}"/>
                            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Margin" Value="4,0,0,0"/>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource WarmGlass}"/>
        <Setter Property="BorderBrush" Value="#D7E8AD88"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="PanelButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="MinHeight" Value="36"/>
    </Style>

    <Style x:Key="PanelLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>

    <Style x:Key="PanelHint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="PanelTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Background" Value="{StaticResource FieldFill}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{StaticResource Brass}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Brass}"/>
        <Setter Property="Padding" Value="11,4"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid SnapsToDevicePixels="True">
                        <controls:GlassBackdrop Radius="10"/>
                        <Border x:Name="Field" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource ControlCorners}" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource GlassHoverLine}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource Brass}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PanelCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" BorderThickness="1"
                                Background="{StaticResource GlassFill}" BorderBrush="{StaticResource GlassLine}"
                                VerticalAlignment="Center" Margin="0,0,8,0">
                            <Path x:Name="Check" Data="M 2,6 L 5,9 10,3" Width="12" Height="12"
                                  Stroke="{StaticResource Ink}" StrokeThickness="1.55" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource WarmGlass}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource GlassHoverLine}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brass}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brass}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Ink}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PanelCombo" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Background" Value="{StaticResource FieldFill}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassLine}"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <controls:GlassBackdrop Radius="10"/>
                        <Border x:Name="ComboSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource ControlCorners}"/>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" Cursor="Hand"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" CornerRadius="{StaticResource ControlCorners}"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          IsHitTestVisible="False" Margin="11,0,27,0" VerticalAlignment="Center"/>
                        <Path Data="M 1,1 L 5,5 9,1" Stroke="{StaticResource Brass}" StrokeThickness="1.3"
                              Width="10" Height="6" HorizontalAlignment="Right" VerticalAlignment="Center"
                              IsHitTestVisible="False" Margin="0,0,12,0"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" VerticalOffset="5">
                            <Border Background="{StaticResource PopupFill}" BorderBrush="{StaticResource GlassLine}"
                                    BorderThickness="1" CornerRadius="{StaticResource PopupCorners}" Padding="3"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer CanContentScroll="True"><ItemsPresenter/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ComboSurface" Property="BorderBrush" Value="{StaticResource GlassHoverLine}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="ComboSurface" Property="BorderBrush" Value="{StaticResource Brass}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="ComboSurface" Property="BorderBrush" Value="{StaticResource Brass}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                    <Setter Property="Padding" Value="10,7"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Brass}"/>
                                        <Setter TargetName="ItemSurface" Property="Background" Value="#344C3849"/>
                                    </Trigger>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="ItemSurface" Property="Background" Value="#605B475D"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
