  m_Name:
  m_EditorClassIdentifier: Assembly-CSharp::MonumentReference
  identity: "\u041F\u0430\u043C\u044F\u0442\u043D\u0438\u043A \u0410. \u0410. \u0414\u0443\u043D\u0438\u043D\u0443-\u0413\u043E\u0440\u043A\u0430\u0432\u0438\u0447\u0443, \u0443\u043B. \u0414\u0443\u043D\u0438\u043D\u0430-\u0413\u043E\u0440\u043A\u0430\u0432\u0438\u0447\u0430, 1"
  source: https://visit-hm.ru/places/216
  accuracy: "\u0422\u043E\u0447\u043A\u0430 \u0441 \u0442\u0443\u0440\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u043F\u043E\u0440\u0442\u0430\u043B\u0430; \u0446\u0435\u043D\u0442\u0440 \u0438 \u043E\u0440\u0438\u0435\u043D\u0442\u0430\u0446\u0438\u044F \u0442\u0440\u0435\u0431\u0443\u044E\u0442 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438. \u0420\u0430\u0437\u043C\u0435\u0440\u044B \u043C\u0430\u043A\u0435\u0442\u0430 \u043F\u043E\u0441\u0442\u0430\u043C\u0435\u043D\u0442\u0430 \u0443\u0441\u043B\u043E\u0432\u043D\u044B. \u0411\u0440\u043E\u043D\u0437\u043E\u0432\u0430\u044F \u0444\u0438\u0433\u0443\u0440\u0430 \u0438 \u0440\u0430\u0441\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u0440\u0435\u043B\u044C\u0435\u0444 \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044E\u0442. \u041D\u0435 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0442\u043E\u0447\u043D\u043E\u0439 \u043A\u043E\u043F\u0438\u0435\u0439. \u0421\u043C. StreetSource/monument_reference.json."
  latitude: 61.001164
  longitude: 69.060422
