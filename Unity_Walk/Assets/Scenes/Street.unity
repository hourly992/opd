  category: "\u21161 \xB7 \u0444\u0438\u0433\u0443\u0440\u043D\u044B\u0439 \u0444\u0440\u043E\u043D\u0442\u043E\u043D, \u043A\u0440\u0443\u0433\u043B\u043E\u0435 \u0443\u0433\u043B\u0443\u0431\u043B\u0435\u043D\u0438\u0435 \u0438 \u0432\u0445\u043E\u0434\u043D\u0430\u044F \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0430"
  observation: "\u041D\u0430 \u043F\u0430\u043D\u043E\u0440\u0430\u043C\u0435 \u0432\u0438\u0434\u043D\u044B \u0430\u0440\u043E\u0447\u043D\u044B\u0439 \u0433\u0440\u0435\u0431\u0435\u043D\u044C \u0441 \u0443\u0441\u0442\u0443\u043F\u0430\u043C\u0438, \u043A\u0440\u0443\u0433\u043B\u043E\u0435 \u0442\u0451\u043C\u043D\u043E\u0435 \u0443\u0433\u043B\u0443\u0431\u043B\u0435\u043D\u0438\u0435 \u043D\u0430\u0434 \u0430\u0440\u043E\u0447\u043D\u044B\u043C \u043E\u043A\u043D\u043E\u043C \u0438 \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0430 \u0441\u043E \u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C\u0438 \u043F\u0435\u0440\u0438\u043B\u0430\u043C\u0438."
  uncertainty: "\u0420\u0430\u0437\u043C\u0435\u0440\u044B \u043E\u0446\u0435\u043D\u0435\u043D\u044B \u043F\u043E \u043F\u0430\u043D\u043E\u0440\u0430\u043C\u0435. \u0428\u0438\u0440\u0438\u043D\u0430 \u0444\u0440\u043E\u043D\u0442\u043E\u043D\u0430 5,4 \u043C, \u0434\u0438\u0430\u043C\u0435\u0442\u0440 \u0443\u0433\u043B\u0443\u0431\u043B\u0435\u043D\u0438\u044F 0,51 \u043C, \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0430 3,14 \xD7 1,79 \u043C, \u043F\u0435\u0440\u0438\u043B\u0430 0,86 \u043C. \u0421\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0430 \u0438\u0441\u0445\u043E\u0434\u043D\u0430\u044F \u043E\u0442\u043C\u0435\u0442\u043A\u0430 \u043F\u043E\u0440\u043E\u0433\u0430, \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u044F \u0441\u0442\u0443\u043F\u0435\u043D\u0435\u0439 \u0438 \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u0447\u0435\u0440\u0435\u0437 \u0437\u0435\u043B\u0451\u043D\u0443\u044E \u043E\u0433\u0440\u0430\u0434\u0443."
  sourceUrls:
  - https://yandex.ru/maps/57/khanty-mansiysk/house/ulitsa_dunina_gorkavicha_1/YkAYdgFgTkADQFhrfXxxcH1lYA==/panorama/?panorama%5Bpoint%5D=69.060451%2C61.001011&panorama%5Bdirection%5D=146.460156%2C-13.047619
  studyBounds:
    m_Center: {x: -103.13009, y: 4.4275, z: 156.92096}
    m_Extent: {x: 2.0422058, y: 4.4624996, z: 2.5857315}
