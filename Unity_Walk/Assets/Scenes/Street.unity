  uncertainty: "\u0413\u0430\u0431\u0430\u0440\u0438\u0442\u044B \u0432\u0438\u0434\u0438\u043C\u043E\u0439 \u043F\u043E\u043B\u043E\u0441\u044B \u0438 \u0441\u0442\u0435\u043D\u043A\u0438 \u043E\u0446\u0435\u043D\u0435\u043D\u044B \u043F\u043E \u0444\u043E\u0442\u043E \u0438 \u043F\u043E\u0434\u043E\u0433\u043D\u0430\u043D\u044B \u043A \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0439 \u0434\u043E\u0440\u043E\u0436\u043A\u0435. \u0421\u043A\u0440\u044B\u0442\u044B\u0435 \u0441\u0442\u0443\u043F\u0435\u043D\u0438 \u0438 \u043F\u0440\u043E\u0444\u0438\u043B\u044C \u0441\u043F\u0443\u0441\u043A\u0430 \u0437\u0430 \u043F\u0430\u0440\u0430\u043F\u0435\u0442\u043E\u043C \u043D\u0435 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u044B."
