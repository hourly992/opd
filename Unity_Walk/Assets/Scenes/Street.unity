--- !u!114 &1154671360
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1154671358}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d61a7f21ec851f544b4834031b02f458, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PhotoSurveyMarker
  category: central court raised lawns and grey pavers
  observation: "\u041B\u0435\u0442\u043D\u0438\u0435 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0438 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0433\u043E \u0434\u0432\u043E\u0440\u0430 \u21167: \u0441\u0435\u0440\u043E\u0435 \u043F\u0440\u044F\u043C\u043E\u0443\u0433\u043E\u043B\u044C\u043D\u043E\u0435 \u043C\u043E\u0449\u0435\u043D\u0438\u0435, \u043F\u0440\u0438\u043F\u043E\u0434\u043D\u044F\u0442\u044B\u0435 \u0433\u0430\u0437\u043E\u043D\u044B, \u0442\u0451\u043C\u043D\u043E-\u043A\u0440\u0430\u0441\u043D\u044B\u0435 \u043F\u043E\u0434\u043F\u043E\u0440\u043D\u044B\u0435 \u0441\u0442\u0435\u043D\u043A\u0438. {\"approximate\":true,\"wallRiseEstimate\":0.3100000023841858,\"minimumReservedPassage\":3.200000047683716,\"TopHeight\":[0.335999995470047,0.335999995470047,0.335999995470047],\"islandCount\":3,\"protectedRouteSegments\":5,\"protectedFootprints\":11,\"note\":\"TopHeight is Unity world Y, not a geodetic altitude. Wall heights and contours are visual estimates; no measured site elevations.\"}"
  uncertainty: "\u041F\u0443\u0431\u043B\u0438\u043A\u0430\u0446\u0438\u044F \u043E\u0431\u044A\u044F\u0432\u043B\u0435\u043D\u0438\u044F 2026-09-09; \u0434\u0430\u0442\u0430 \u0441\u044A\u0451\u043C\u043A\u0438 \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u0430. \u041A\u043E\u043D\u0442\u0443\u0440\u044B, \u0448\u0438\u0440\u0438\u043D\u044B \u0438 \u043F\u043E\u0434\u044A\u0451\u043C \u0441\u0442\u0435\u043D\u043E\u043A ~0.31 \u043C \u043E\u0446\u0435\u043D\u043E\u0447\u043D\u044B\u0435. TopHeight \u2014 Y Unity, \u043D\u0435 \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u0430\u044F \u0432\u044B\u0441\u043E\u0442\u0430 \u043C\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u0438. \u041F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u0437\u0434\u0430\u043D\u0438\u0439, \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u044B, \u043F\u0430\u0440\u043A\u043E\u0432\u043A\u0438, \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u044B \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u044B; \u043E\u0431\u0449\u0438\u0439 \u0445\u043E\u043B\u043C \u0440\u0430\u0439\u043E\u043D\u0430 \u043F\u043E \u044D\u0442\u0438\u043C \u0444\u043E\u0442\u043E \u043D\u0435 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D."
  sourceUrls:
  - https://realty.yandex.ru/offer/4006141392816993274/
  - https://avatars.mds.yandex.net/get-realty-offers/15038303/2d86a840-819c-4ef2-a67e-6098b9d2a49e/app_large
  - https://avatars.mds.yandex.net/get-realty-offers/14021747/b50d2391-f3f6-4cf7-b362-9896c4513b7f/app_large
  studyBounds:
    m_Center: {x: 41, y: 0, z: 37.75}
    m_Extent: {x: 17.2, y: 0.7, z: 9.35}
  geometryProvisional: 1
