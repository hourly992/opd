  observation: "\u041D\u0430 \u043B\u0435\u0442\u043D\u0438\u0445 \u0444\u043E\u0442\u043E \u21167: \u043F\u043E\u0434\u043D\u044F\u0442\u044B\u0435 \u0433\u0430\u0437\u043E\u043D\u044B, \u0448\u0442\u0443\u0447\u043D\u044B\u0435 \u043A\u0440\u0430\u0441\u043D\u043E-\u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u044B\u0435 \u043D\u0430\u043A\u0440\u044B\u0432\u043A\u0438 \u0438 \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u043E\u0435 \u0441\u0435\u0440\u043E\u0435 \u043C\u043E\u0449\u0435\u043D\u0438\u0435 \u0434\u043E \u043D\u0438\u0437\u043A\u043E\u0439 \u0434\u0432\u0435\u0440\u0438."
  uncertainty: "\u041A\u043E\u043D\u0442\u0443\u0440\u044B \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u044B \u0438\u0437 \u043F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0435\u0433\u043E \u044D\u0442\u0430\u043F\u0430. \u0412\u044B\u043F\u0443\u043A\u043B\u043E\u0441\u0442\u044C \u0433\u0440\u0443\u043D\u0442\u0430 4.5\u0441\u043C \u0438 \u0440\u0430\u0437\u043C\u0435\u0440\u044B \u043D\u0430\u043A\u0440\u044B\u0432\u043E\u043A \u043E\u0446\u0435\u043D\u043E\u0447\u043D\u044B\u0435. \u042D\u0442\u043E \u043D\u0435 \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u044B\u0435 \u0432\u044B\u0441\u043E\u0442\u044B \u0440\u0430\u0439\u043E\u043D\u0430 \u0438 \u043D\u0435 \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u0433\u0430\u0440\u0430\u0436\u043D\u043E\u0433\u043E \u0441\u043F\u0443\u0441\u043A\u0430."
