  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PhotoSurveyMarker
  category: "\u211613 \xB7 \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0430 \u0438 \u0434\u0432\u0435 \u043D\u0438\u0437\u043A\u0438\u0435 \u0441\u0442\u0443\u043F\u0435\u043D\u0438"
  observation: "\u0410\u0434\u0440\u0435\u0441\u043D\u044B\u0439 \u043A\u0430\u0434\u0440 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0443\u0433\u043E\u043B \u0434\u043E\u043C\u0430, \u043E\u0431\u0449\u0443\u044E \u043D\u0438\u0437\u043A\u0443\u044E \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0443 \u0438 \u0431\u043E\u043A\u043E\u0432\u043E\u0439 \u043F\u043E\u0434\u0445\u043E\u0434. \u041D\u0430 \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432\u043E\u043C \u043A\u0430\u0434\u0440\u0435 \u043F\u043E\u043B\u043E\u0441\u0430 \u043D\u0430\u0432\u0435\u0441\u0430 \u0441\u043E\u0432\u043F\u0430\u0434\u0430\u0435\u0442 \u0441 \u0441\u0435\u0432\u0435\u0440\u043D\u044B\u043C \u0442\u043E\u0440\u0446\u0435\u0432\u044B\u043C \u0432\u0445\u043E\u0434\u043E\u043C."
  uncertainty: "\u041F\u0440\u0438\u0432\u044F\u0437\u043A\u0430 \u043F\u043E \u0443\u0433\u043B\u0443 \u0444\u0430\u0441\u0430\u0434\u0430 \u0438 \u043D\u0430\u0432\u0435\u0441\u0443 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0432\u044B\u0432\u043E\u0434\u043E\u043C \u0438\u0437 \u0441\u043E\u043F\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u044F. \u0413\u0430\u0431\u0430\u0440\u0438\u0442\u044B \u0438 \u0432\u044B\u0441\u043E\u0442\u044B \u0441\u0442\u0443\u043F\u0435\u043D\u0435\u0439 \u043E\u0446\u0435\u043D\u0435\u043D\u044B \u043F\u043E \u043C\u0435\u0441\u0442\u0443."
  sourceUrls:
