MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 132875718}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d61a7f21ec851f544b4834031b02f458, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PhotoSurveyMarker
  category: "\u0414\u043E\u043C \u211615 \xB7 \u0441\u043E\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u0435 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0439 \u0443 \u0436\u0438\u043B\u043E\u0433\u043E \u043A\u0440\u044B\u043B\u044C\u0446\u0430"
  observation: "\u0410\u0434\u0440\u0435\u0441\u043D\u044B\u0439 \u043A\u0430\u0434\u0440 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043F\u043E\u0440\u044F\u0434\u043E\u043A \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0439 \u043E\u0442 \u043F\u0440\u043E\u0435\u0437\u0434\u0430 \u043A \u0444\u0430\u0441\u0430\u0434\u0443: \u0441\u0432\u0435\u0442\u043B\u044B\u0439 \u0431\u043E\u0440\u0434\u044E\u0440, \u043A\u0440\u0430\u0441\u043D\u0430\u044F \u043F\u043B\u0438\u0442\u043A\u0430, \u0433\u0430\u0437\u043E\u043D \u0438 \u0441\u0435\u0440\u0430\u044F \u043E\u0442\u043C\u043E\u0441\u0442\u043A\u0430. \u0418\u0437\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0430\u044F \u043F\u043B\u0438\u0442\u043A\u0430 \u0443 \u043A\u0440\u044B\u043B\u044C\u0446\u0430 \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0430 \u0441 \u043F\u0440\u043E\u0434\u043E\u043B\u044C\u043D\u043E\u0439 \u0434\u043E\u0440\u043E\u0436\u043A\u043E\u0439."
  uncertainty: "\u0421\u043D\u0438\u043C\u043E\u043A Mr.Shkaf \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0439 \u043D\u0438\u0437\u043A\u0438\u0439 \u043A\u043E\u043C\u043C\u0435\u0440\u0447\u0435\u0441\u043A\u0438\u0439 \u0432\u0445\u043E\u0434. \u041F\u0440\u043E\u0444\u0438\u043B\u044C \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0439 \u043F\u0440\u0438\u043C\u0435\u043D\u0451\u043D \u043A \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u043C\u0443 \u0436\u0438\u043B\u043E\u043C\u0443 \u043F\u043E\u0434\u0445\u043E\u0434\u0443; \u0435\u0433\u043E \u0433\u0430\u0431\u0430\u0440\u0438\u0442\u044B \u043E\u0446\u0435\u043D\u043E\u0447\u043D\u044B\u0435 \u0438 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u044B \u043D\u0430 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E\u0439 \u043F\u043B\u043E\u0449\u0430\u0434\u0438 \u0442\u0435\u043A\u0443\u0449\u0435\u0439 \u043C\u043E\u0434\u0435\u043B\u0438."
  sourceUrls:
  - https://avatars.mds.yandex.net/get-altay/18116908/2a0000019e4a3c0752c03f837c748d226820/orig
  - https://yandex.ru/maps/57/khanty-mansiysk/house/ulitsa_dunina_gorkavicha_15/YkAYdgFjT0cHQFhqfXV4eXtlZQ==/panorama/?panorama%5Bpoint%5D=69.063256%2C60.998531&panorama%5Bdirection%5D=148.390169%2C-15.142857
  studyBounds:
    m_Center: {x: 72.72, y: 0.07991066, z: -107.225006}
    m_Extent: {x: 1.6199951, y: 0.018335454, z: 2.574997}
  geometryProvisional: 1
