  m_Script: {fileID: 11500000, guid: d61a7f21ec851f544b4834031b02f458, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PhotoSurveyMarker
  category: "\u042E\u0433 \xB7 \u0441\u0442\u044B\u043A \u0430\u0441\u0444\u0430\u043B\u044C\u0442\u0430 \u0441 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0439 \u0431\u0440\u0443\u0441\u0447\u0430\u0442\u043A\u043E\u0439"
  observation: "\u0412 \u0430\u0434\u0440\u0435\u0441\u043D\u043E\u043C \u043A\u0430\u0434\u0440\u0435 \u0432\u0438\u0434\u043D\u044B \u043A\u0440\u0430\u0441\u043D\u0430\u044F \u043F\u043B\u0438\u0442\u043A\u0430, \u0441\u0432\u0435\u0442\u043B\u0430\u044F \u043A\u0440\u043E\u043C\u043A\u0430, \u0433\u0430\u0437\u043E\u043D \u0438 \u0441\u0435\u0440\u0430\u044F \u043E\u0442\u043C\u043E\u0441\u0442\u043A\u0430. \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0439 \u0442\u0440\u043E\u0442\u0443\u0430\u0440 \u0438 \u043F\u0440\u0438\u043C\u044B\u043A\u0430\u044E\u0449\u0430\u044F \u043F\u043E\u043B\u043E\u0441\u0430 \u0433\u0430\u0437\u043E\u043D\u0430 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u044B. \u041D\u0430 \u043C\u043E\u0434\u0435\u043B\u0438 \u0443\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u043E \u043D\u0430\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u0430\u0441\u0444\u0430\u043B\u044C\u0442\u0430 \u043D\u0430 \u043A\u0440\u0430\u0441\u043D\u044B\u0439 \u043F\u043E\u0434\u0445\u043E\u0434."
  uncertainty: "\u041F\u043E\u0434\u0440\u0435\u0437\u043A\u0430 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u0438 \u0442\u0435\u043A\u0443\u0449\u0435\u0439 \u0441\u0446\u0435\u043D\u044B. \u0410\u0434\u0440\u0435\u0441\u043D\u043E\u0435 \u0444\u043E\u0442\u043E \u043D\u0435 \u0434\u0430\u0451\u0442 \u043F\u0440\u0438\u0432\u044F\u0437\u043A\u0438 \u043A \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u043E\u043C\u0443 \u043F\u043E\u0440\u043E\u0433\u0443 \u0438 \u043D\u0435 \u0437\u0430\u0434\u0430\u0451\u0442 \u043E\u0442\u043C\u0435\u0442\u043E\u043A \u0433\u0440\u0443\u043D\u0442\u0430."
  sourceUrls:
  - https://avatars.mds.yandex.net/get-altay/18116908/2a0000019e4a3c0752c03f837c748d226820/orig
  - https://yandex.ru/maps/57/khanty-mansiysk/house/ulitsa_dunina_gorkavicha_15/YkAYdgFjT0cHQFhqfXV4eXtlZQ==/panorama/?panorama%5Bpoint%5D=69.063256%2C60.998531&panorama%5Bdirection%5D=148.390169%2C-15.142857
  studyBounds:
