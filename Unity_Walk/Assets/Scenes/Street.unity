  observation: "\u0414\u0432\u0435 \u0441\u0432\u0435\u0442\u043B\u044B\u0435 \u0440\u0435\u0435\u0447\u043D\u044B\u0435 \u0441\u043A\u0430\u043C\u044C\u0438 \u043D\u0430 \u0431\u0435\u0442\u043E\u043D\u043D\u044B\u0445 \u043E\u043F\u043E\u0440\u0430\u0445 \u0441\u0442\u043E\u044F\u0442 \u0440\u044F\u0434\u043E\u043C \u0441 \u0431\u043E\u0440\u0442\u0438\u043A\u043E\u043C \u043F\u043E\u0434\u043D\u044F\u0442\u043E\u0433\u043E \u0433\u0430\u0437\u043E\u043D\u0430 \u043D\u0430 \u0443\u0440\u043E\u0432\u043D\u0435 \u0441\u0435\u0440\u043E\u0433\u043E \u043C\u043E\u0449\u0435\u043D\u0438\u044F."
  uncertainty: "\u0422\u0438\u043F \u0438 \u0447\u0438\u0441\u043B\u043E \u0441\u043A\u0430\u043C\u0435\u0439 \u0432\u0438\u0434\u043D\u044B \u043D\u0430 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0438. \u0420\u0430\u0437\u043C\u0435\u0440\u044B \u0438 \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0442\u044B \u043E\u0446\u0435\u043D\u043E\u0447\u043D\u044B\u0435, \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u043F\u043E\u0434\u043E\u0433\u043D\u0430\u043D\u043E \u043A \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u043C\u0443 \u043E\u0441\u0442\u0440\u043E\u0432\u0443 \u0438 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u043C\u0443 \u043F\u0440\u043E\u0445\u043E\u0434\u0443."
