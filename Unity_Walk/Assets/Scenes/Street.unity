  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PhotoSurveyMarker
  category: lighting
  observation: "\u0421\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u044B \u0442\u043E\u0447\u043A\u0438 \u043F\u0440\u0435\u0436\u043D\u0438\u0445 \u0443\u043B\u0438\u0447\u043D\u044B\u0445 \u043E\u043F\u043E\u0440. \u0414\u0432\u0443\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u0435 \u0441\u0432\u0435\u0442\u0438\u043B\u044C\u043D\u0438\u043A\u0438 \u0438 \u043C\u0430\u0441\u0448\u0442\u0430\u0431 \u0441\u043E\u043F\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u044B \u0441 \u0443\u043B\u0438\u0447\u043D\u044B\u043C\u0438 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u044F\u043C\u0438."
  uncertainty: "\u0414\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0435 \u0434\u0432\u043E\u0440\u043E\u0432\u044B\u0435 \u043E\u043F\u043E\u0440\u044B \u2014 \u043F\u0440\u043E\u0435\u043A\u0442\u043D\u043E\u0435 \u0434\u043E\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435 \u0432\u0434\u043E\u043B\u044C \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0445 \u043F\u043E\u0434\u0445\u043E\u0434\u043E\u0432, \u0430 \u043D\u0435 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0451\u043D\u043D\u0430\u044F \u0441\u044A\u0451\u043C\u043A\u043E\u0439 \u0440\u0430\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430. \u041C\u043E\u0434\u0435\u043B\u0438 \u043E\u0446\u0435\u043D\u043E\u0447\u043D\u044B\u0435."
