  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PhotoSurveyMarker
  category: "\u0412\u043E\u0441\u0442\u043E\u0447\u043D\u044B\u0439 \u0441\u0435\u043A\u0442\u043E\u0440 \xB7 \u043B\u0435\u0441 \u0437\u0430 \u0434\u0432\u043E\u0440\u0430\u043C\u0438"
  observation: "\u041D\u0430 \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432\u043E\u043C \u043A\u0430\u0434\u0440\u0435 \u043E\u043F\u0443\u0448\u043A\u0430 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u0437\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0439 \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u043E\u0439 \u0438 \u0441\u0435\u0432\u0435\u0440\u043D\u044B\u043C\u0438 \u043F\u0440\u043E\u0435\u0437\u0434\u0430\u043C\u0438 \u0434\u043E\u043C\u043E\u0432 \u211613."
  uncertainty: "\u0413\u0440\u0430\u043D\u0438\u0446\u0430 \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0451\u043D\u043D\u043E \u043F\u0435\u0440\u0435\u043D\u0435\u0441\u0435\u043D\u0430 \u043F\u043E \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432\u043E\u043C\u0443 \u043A\u0430\u0434\u0440\u0443. \u041F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0445 \u0434\u0435\u0440\u0435\u0432\u044C\u0435\u0432, \u0432\u044B\u0441\u043E\u0442\u044B \u0438 \u043F\u043E\u0440\u043E\u0434\u043D\u044B\u0439 \u0441\u043E\u0441\u0442\u0430\u0432 \u043E\u0446\u0435\u043D\u043E\u0447\u043D\u044B\u0435."
