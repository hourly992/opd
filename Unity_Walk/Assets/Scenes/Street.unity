  m_Script: {fileID: 11500000, guid: d61a7f21ec851f544b4834031b02f458, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PhotoSurveyMarker
  category: "\u21161 \xB7 \u0437\u0435\u043B\u0451\u043D\u0430\u044F \u043E\u0433\u0440\u0430\u0434\u0430 \u0438 \u043F\u043E\u0441\u0430\u0434\u043A\u0438 \u0443 \u043A\u0440\u0430\u0441\u043D\u043E\u0433\u043E \u0442\u0440\u043E\u0442\u0443\u0430\u0440\u0430"
  observation: "\u041D\u0430 \u043F\u0430\u043D\u043E\u0440\u0430\u043C\u0435 \u0432\u0438\u0434\u043D\u044B \u043D\u0438\u0437\u043A\u0430\u044F \u0437\u0435\u043B\u0451\u043D\u0430\u044F \u043E\u0433\u0440\u0430\u0434\u0430, \u043F\u0440\u043E\u0445\u043E\u0434 \u043A \u0444\u0430\u0441\u0430\u0434\u0443 \u0438 \u0434\u0435\u0440\u0435\u0432\u044C\u044F \u0437\u0430 \u0440\u0435\u0448\u0451\u0442\u043A\u043E\u0439."
  uncertainty: "\u0412\u044B\u0441\u043E\u0442\u0430 \u0441\u0435\u043A\u0446\u0438\u0439 \u0438 \u0442\u043E\u0447\u043A\u0438 \u043F\u043E\u0441\u0430\u0434\u043A\u0438 \u043E\u0446\u0435\u043D\u0435\u043D\u044B \u043F\u043E \u043F\u0430\u043D\u043E\u0440\u0430\u043C\u0435. \u041F\u0440\u043E\u0445\u043E\u0434 \u043F\u0440\u0438\u0432\u044F\u0437\u0430\u043D \u043A \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0439 \u0434\u043E\u0440\u043E\u0436\u043A\u0435 \u0432 \u0441\u0446\u0435\u043D\u0435."
  sourceUrls:
  - https://yandex.ru/maps/57/khanty-mansiysk/house/ulitsa_dunina_gorkavicha_1/YkAYdgFgTkADQFhrfXxxcH1lYA==/panorama/?panorama%5Bpoint%5D=69.060451%2C61.001011&panorama%5Bdirection%5D=146.460156%2C-13.047619
  studyBounds:
    m_Center: {x: -111.868, y: 0.53650004, z: 157.15001}
    m_Extent: {x: 8.753273, y: 0.5865, z: 15.686005}
  geometryProvisional: 1
