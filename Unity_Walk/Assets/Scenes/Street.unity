--- !u!114 &1084678201
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1084678199}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d61a7f21ec851f544b4834031b02f458, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PhotoSurveyMarker
  category: "\u0412\u043E\u0441\u0442\u043E\u0447\u043D\u044B\u0439 \u0441\u0435\u043A\u0442\u043E\u0440 \xB7 \u0432\u0445\u043E\u0434 \u211611 \u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u211613"
  observation: "\u041B\u0435\u0442\u043D\u0438\u0439 \u043A\u0430\u0434\u0440 \u211611 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043A\u0440\u0430\u0441\u043D\u0443\u044E \u0434\u043E\u0440\u043E\u0436\u043A\u0443 \u0447\u0435\u0440\u0435\u0437 \u0433\u0430\u0437\u043E\u043D \u0438 \u0441\u0432\u0435\u0442\u043B\u044B\u0439 \u0434\u043E\u0440\u043E\u0436\u043D\u044B\u0439 \u0431\u043E\u0440\u0434\u044E\u0440. \u041A\u0440\u0430\u0441\u043D\u043E\u0435 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0435 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0435\u043D\u043E \u043F\u043E \u043D\u0430\u043A\u043B\u043E\u043D\u043D\u043E\u043C\u0443 \u0443\u0447\u0430\u0441\u0442\u043A\u0443. \u041D\u0438\u0436\u043D\u044F\u044F \u043A\u0440\u043E\u043C\u043A\u0430 \u043F\u043E\u0434\u043E\u0433\u043D\u0430\u043D\u0430 \u043A \u043E\u0441\u0438 \u0438 \u0448\u0438\u0440\u0438\u043D\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0439 \u0434\u0438\u0430\u0433\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0439 \u0434\u043E\u0440\u043E\u0436\u043A\u0438."
  uncertainty: "\u0428\u0438\u0440\u0438\u043D\u0430 \u0438 \u043E\u0442\u043C\u0435\u0442\u043A\u0438 \u043F\u043E\u0440\u043E\u0433\u0430 \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435. \u0423 \u211613 \u0444\u043E\u0442\u043E \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044E\u0442 \u043D\u0435\u0432\u044B\u0441\u043E\u043A\u0438\u0439 \u0443\u0437\u0435\u043B \u0441\u043E \u0441\u0442\u0443\u043F\u0435\u043D\u044F\u043C\u0438, \u043D\u043E \u043D\u0435 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u043E\u043C\u0443 \u043C\u043E\u0434\u0435\u043B\u044C\u043D\u043E\u043C\u0443 \u043F\u0440\u043E\u0451\u043C\u0443. \u0413\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u044F \u211613 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0430."
  sourceUrls:
  - https://yandex.ru/maps/org/91706029280/
  - https://avatars.mds.yandex.net/get-altay/16333276/2a00000198bb44206efe19b972c5a4dbad39/orig
  - https://yandex.ru/maps/org/169841655322/
  - https://avatars.mds.yandex.net/get-altay/16569030/2a00000198543ee61cdd8958713a87e97a35/orig
