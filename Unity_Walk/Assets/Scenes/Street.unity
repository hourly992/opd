--- !u!114 &10855022
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 10855020}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d61a7f21ec851f544b4834031b02f458, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PhotoSurveyMarker
  category: "\u042E\u0436\u043D\u044B\u0439 \u0442\u043E\u0440\u0435\u0446 \u0434\u043E\u043C\u0430 \u21166 \xB7 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0430"
  observation: "\u041B\u0435\u0442\u043D\u0438\u0439 \u043A\u0430\u0434\u0440 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0436\u0451\u043B\u0442\u0443\u044E \u0444\u0430\u0441\u0430\u0434\u043D\u0443\u044E \u0442\u0440\u0443\u0431\u0443 \u0438 \u043F\u043E\u043B\u043E\u0433\u0438\u0439 \u0437\u0435\u043B\u0451\u043D\u044B\u0439 \u043D\u0430\u0432\u0435\u0441. \u0422\u043E\u0447\u043A\u0430 \u0432\u0445\u043E\u0434\u0430 \u042F\u043D\u0434\u0435\u043A\u0441 69.06164724, 60.99928883, \u0430\u0437\u0438\u043C\u0443\u0442 180.957\xB0. \u041D\u0430\u0432\u0435\u0441 \u0432 \u0441\u0446\u0435\u043D\u0435 \u0437\u0430\u043C\u0435\u043D\u0451\u043D: \u0434\u0430"
  uncertainty: "\u0414\u043B\u0438\u043D\u044B, \u0432\u044B\u0441\u043E\u0442\u044B \u0438 \u0443\u0437\u043B\u044B \u0442\u0440\u0443\u0431\u044B \u043E\u0446\u0435\u043D\u043E\u0447\u043D\u044B\u0435. \u0417\u0430\u0433\u043B\u0443\u0431\u043B\u0435\u043D\u0438\u0435 \u0437\u0430 \u043F\u0430\u0440\u0430\u043F\u0435\u0442\u043E\u043C \u0432\u0438\u0434\u043D\u043E, \u0442\u043E\u0447\u043D\u044B\u0439 \u043F\u0440\u043E\u0444\u0438\u043B\u044C \u0441\u043F\u0443\u0441\u043A\u0430 \u0437\u0430\u043A\u0440\u044B\u0442. \u041F\u0440\u0438\u0432\u044F\u0437\u043A\u0430 \u0434\u0435\u0442\u0430\u043B\u0438 \u0441\u0434\u0435\u043B\u0430\u043D\u0430 \u043A \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u043C\u0443 \u044E\u0436\u043D\u043E\u043C\u0443 \u0442\u043E\u0440\u0446\u0443 \u0438 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0443."
  sourceUrls:
  - https://yandex.ru/maps/org/1334869298/
  - https://avatars.mds.yandex.net/get-altay/986332/2a00000163b68406656e7a5f1e6fb3210d56/orig
  studyBounds:
    m_Center: {x: -44.423084, y: 1.25, z: -46.617}
    m_Extent: {x: 4.1, y: 1.3, z: 0.95}
  geometryProvisional: 1
