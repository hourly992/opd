  observation: "\u0412\u0438\u0434\u043D\u044B \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u043E\u0435 \u0441\u0435\u0440\u043E\u0435 \u043C\u043E\u0449\u0435\u043D\u0438\u0435, \u043D\u0438\u0437\u043A\u0438\u0439 \u0441\u0435\u0440\u044B\u0439 \u0432\u0445\u043E\u0434 \u0438 \u0448\u0438\u0440\u043E\u043A\u0438\u0439 \u043A\u043E\u0437\u044B\u0440\u0451\u043A \u0441 \u0442\u043E\u043D\u043A\u0438\u043C \u0441\u0432\u0435\u0442\u043B\u044B\u043C \u043A\u043E\u043D\u0442\u0443\u0440\u043E\u043C."
  uncertainty: "\u041E\u0442\u043A\u043E\u0441\u044B, \u043D\u0430\u043B\u0438\u0447\u043D\u0438\u043A, \u043A\u0440\u043E\u043C\u043A\u0438 \u0438 \u0434\u0435\u0442\u0430\u043B\u0438 \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0439 \u043E\u0446\u0435\u043D\u043E\u0447\u043D\u044B\u0435. \u0421\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u044B \u043F\u0440\u0435\u0436\u043D\u0438\u0435 \u0443\u0440\u043E\u0432\u043D\u0438, \u043A\u043E\u043D\u0442\u0443\u0440\u044B \u0438 \u043A\u043E\u043B\u043B\u0438\u0437\u0438\u0438 \u043F\u043E\u0434\u0445\u043E\u0434\u0430."
  sourceUrls:
  - https://realty.yandex.ru/offer/4006141392816993274/
  - https://avatars.mds.yandex.net/get-realty-offers/15038303/2d86a840-819c-4ef2-a67e-6098b9d2a49e/app_large
  studyBounds:
    m_Center: {x: 62.091938, y: 1.5, z: 38.305}
    m_Extent: {x: 1.5, y: 1.5, z: 2.65}
  geometryProvisional: 1
