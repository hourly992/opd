  observation: "\u0421\u0435\u0440\u043E\u0435 \u043C\u043E\u0449\u0435\u043D\u0438\u0435 \u043E\u0431\u0440\u0430\u0437\u0443\u0435\u0442 \u0435\u0434\u0438\u043D\u043E\u0435 \u043F\u043E\u043B\u043E\u0442\u043D\u043E. \u041F\u043E \u0438\u0433\u0440\u043E\u0432\u043E\u043C\u0443 \u043A\u0430\u0434\u0440\u0443 \u0438 \u043B\u0443\u0447\u0435\u0432\u044B\u043C \u043F\u0440\u043E\u0431\u0430\u043C \u043D\u0430\u0439\u0434\u0435\u043D \u0432\u044B\u0441\u0442\u0443\u043F \u0441\u0442\u0430\u0440\u043E\u0439 \u043A\u0440\u0430\u0441\u043D\u043E\u0439 \u0434\u043E\u0440\u043E\u0436\u043A\u0438 \u0432\u043D\u0443\u0442\u0440\u0438 \u043F\u043E\u043B\u043E\u0442\u043D\u0430."
  uncertainty: "\u0421\u0440\u0435\u0437 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D \u0443\u0447\u0430\u0441\u0442\u043A\u043E\u043C \u0441 \u043E\u043F\u043E\u0440\u043E\u0439 \u043D\u0430 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0435 \u0441\u0435\u0440\u043E\u0435 \u043C\u043E\u0449\u0435\u043D\u0438\u0435. \u0412\u044B\u0441\u043E\u0442\u044B \u0432\u0437\u044F\u0442\u044B \u0438\u0437 \u0441\u043E\u0445\u0440\u0430\u043D\u0451\u043D\u043D\u043E\u0439 \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u0438."
