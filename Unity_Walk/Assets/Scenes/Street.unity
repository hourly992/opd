--- !u!114 &1827033063
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1827033061}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d61a7f21ec851f544b4834031b02f458, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PhotoSurveyMarker
  category: asphalt boundary construction estimate
  observation: "\u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0430\u044F \u043A\u0440\u043E\u043C\u043A\u0430 \u0432\u0442\u043E\u0440\u0438\u0447\u043D\u043E\u0433\u043E \u0430\u0441\u0444\u0430\u043B\u044C\u0442\u0430 \u0431\u0435\u0437 \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0430 \u0432\u0435\u0440\u0445\u0430. \u0423 \u0431\u043E\u0440\u0434\u044E\u0440\u043E\u0432, \u0442\u0440\u043E\u0442\u0443\u0430\u0440\u043E\u0432, \u0432\u0445\u043E\u0434\u043E\u0432 \u0438 \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432 \u043F\u043E\u0434\u0441\u044B\u043F\u043A\u0430 \u043D\u0435 \u0441\u043E\u0437\u0434\u0430\u0451\u0442\u0441\u044F. \u041D\u0430\u0440\u0443\u0436\u043D\u044B\u0439 \u043A\u0440\u0430\u0439 \u0437\u0430\u0433\u043B\u0443\u0431\u043B\u0451\u043D \u0432 \u0444\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0433\u0440\u0443\u043D\u0442."
  uncertainty: "\u0428\u0438\u0440\u0438\u043D\u0430 \u043E\u0431\u044B\u0447\u043D\u043E 0,32\u043C, \u0434\u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F 0,14\u20130,55\u043C; \u0444\u043E\u0440\u043C\u0430 \u0438 \u0442\u043E\u043B\u0449\u0438\u043D\u0430 \u043F\u043E\u0434\u0441\u044B\u043F\u043A\u0438 \u2014 \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0435 \u0438\u043D\u0436\u0435\u043D\u0435\u0440\u043D\u043E\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u0435, \u0430 \u043D\u0435 \u043E\u0431\u043C\u0435\u0440 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0439 \u043E\u0431\u043E\u0447\u0438\u043D\u044B. \u041D\u043E\u0432\u044B\u0435 \u043B\u043E\u0442\u043A\u0438, \u043A\u043E\u043B\u043E\u0434\u0446\u044B \u0438 \u043B\u0438\u0432\u043D\u0451\u0432\u043A\u0438 \u043D\u0435 \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u043B\u0438\u0441\u044C."
  sourceUrls:
  - https://yandex.ru/maps/org/91706029280/
  - https://yandex.ru/maps/org/159257372149/
  studyBounds:
    m_Center: {x: 40, y: 0, z: -20}
    m_Extent: {x: 200, y: 0.5, z: 235}
  geometryProvisional: 1
