  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PhotoSurveyMarker
  category: "\u211613 \xB7 \u0434\u043B\u0438\u043D\u043D\u044B\u0439 \u043E\u0434\u043D\u043E\u0441\u043A\u0430\u0442\u043D\u044B\u0439 \u043D\u0430\u0432\u0435\u0441"
  observation: "\u0410\u0434\u0440\u0435\u0441\u043D\u044B\u0439 \u043A\u0430\u0434\u0440 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043D\u0438\u0437\u043A\u0443\u044E \u0437\u0435\u043B\u0451\u043D\u0443\u044E \u043A\u0440\u043E\u0432\u043B\u044E \u0432\u0434\u043E\u043B\u044C \u0442\u043E\u0440\u0446\u0430 \u0438 \u0442\u043E\u043D\u043A\u0438\u0435 \u043E\u043F\u043E\u0440\u044B. \u0424\u043E\u0440\u043C\u0430 \u0438 \u043F\u0440\u043E\u043F\u043E\u0440\u0446\u0438\u0438 \u043F\u0440\u0438\u0432\u044F\u0437\u0430\u043D\u044B \u043A \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u043C\u0443 \u0441\u0435\u0432\u0435\u0440\u043D\u043E\u043C\u0443 \u0432\u0445\u043E\u0434\u0443."
  uncertainty: "\u0428\u0438\u0440\u0438\u043D\u0430, \u0443\u043A\u043B\u043E\u043D, \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u0441\u0442\u043E\u0435\u043A \u0438 \u043F\u0440\u043E\u0444\u0438\u043B\u044C \u043A\u0440\u043E\u043C\u043A\u0438 \u043E\u0446\u0435\u043D\u0435\u043D\u044B \u043F\u043E \u043A\u0430\u0434\u0440\u0443 \u0438 \u043F\u043E \u0440\u0430\u0437\u043C\u0435\u0440\u0430\u043C \u0438\u0433\u0440\u043E\u0432\u043E\u0439 \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0438."
