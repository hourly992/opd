  address: "\u0443\u043B. \u0414\u0443\u043D\u0438\u043D\u0430-\u0413\u043E\u0440\u043A\u0430\u0432\u0438\u0447\u0430, 15"
  evidenceLevel: OSM parking footprint; access connection estimated from mapped service road
