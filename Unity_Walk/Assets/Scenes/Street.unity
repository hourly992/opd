  category: kerb
  observation: "\u041D\u0438\u0437\u043A\u0430\u044F \u0441\u0432\u0435\u0442\u043B\u0430\u044F \u043A\u0440\u043E\u043C\u043A\u0430 \u0443 \u043A\u0440\u0430\u0441\u043D\u043E\u0439 \u0434\u043E\u0440\u043E\u0436\u043A\u0438 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0430 \u0444\u043E\u0442\u043E \u211611. \u0422\u0440\u0451\u0445\u043C\u0435\u0440\u043D\u043E\u0435 \u0441\u0435\u0447\u0435\u043D\u0438\u0435 \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u043E \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u0445 \u0433\u0440\u0430\u043D\u0438\u0446\u0430\u0445 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0439 \u0434\u043E\u0440\u043E\u0436\u043A\u0438."
  uncertainty: "\u041F\u043B\u0430\u043D \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0433\u043E \u043F\u043E\u0434\u0445\u043E\u0434\u0430 \u0441\u043E\u0445\u0440\u0430\u043D\u0451\u043D \u043A\u0430\u043A \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0439. \u0428\u0438\u0440\u0438\u043D\u0430 80\u043C\u043C \u0438 \u0444\u0430\u0441\u043A\u04308\u043C\u043C \u2014 \u043E\u0446\u0435\u043D\u043A\u0430, \u043D\u0435 \u043E\u0431\u043C\u0435\u0440."
